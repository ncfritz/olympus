# The build context for every image built from the repository root
# (ADR 0011, 0019): the sources, and nothing built, installed, local or
# secret. A Dockerfile never copies an env file into an image.

.git
**/node_modules
**/dist
**/.turbo
**/.next
**/coverage
**/test-report
**/*.tsbuildinfo
**/.DS_Store
**/logs

# Configuration and secrets stay on the host.
**/*.env
**/*.env.*
**/.env*
**/*.key
**/*.p12
infra/dev-ca

# Local data.
**/*.db
**/*.db-journal
**/*.sqlite

Claude outputs
