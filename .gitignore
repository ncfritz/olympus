node_modules/
dist/
.next/
out/
coverage/
test-report/
.openapi-check/
.signer-client-check/
.turbo/
*.tsbuildinfo
logs/
graph.json
*.log
.DS_Store
# Editor leftovers. A vim swap file reached a commit once.
*.sw[a-p]
*~
.idea/
*.iml

# Environment files hold secrets. Commit *.env.example instead.
*.env
.env*
!*.env.example
!.env.example
# Except the hosts' settings for the Docker stacks: no secrets, by design
# (ADR 0019). Secrets are files in each host's SECRETS_DIR.
!infra/docker/env/*.env
!infra/docker/env/*/*.env

# Local certs / keys
*.pem
!**/ca_roots.pem

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# The metadata agent's fetch job cache (DIONYSUS_CACHE_PATH default)
agents/dionysus-metadata/cache/

# The mail classifier's feature store (FEATURE_STORE_PATH default):
# derived data, never committed.
agents/minerva-mail-ml/data/
# The mail agent's Gmail refresh tokens, one file per linked mailbox.
agents/minerva-mail/data/

# A throwaway CA for development (scripts/dev-ca.sh).
infra/dev-ca/

# The host infra/docker/stack.sh runs as (stack.sh bootstrap <host>).
infra/docker/env/.current

# Scratch output from Claude sessions.
Claude outputs/

# The API's raw weather archive when run from the workspace
weather-archive/
