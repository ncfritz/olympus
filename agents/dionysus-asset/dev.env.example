# Copy to dev.env / local.env / production.env (all git-ignored) and fill in.
# `pnpm dev` reads dev.env, `pnpm dev:local` reads local.env.
#
# dev.env (`pnpm dev`) runs this service from the IDE in the home lab,
# against the Mac Mini's dev infrastructure: hasura-dev and RabbitMQ's
# /dionysus-dev vhost as the olympus-dev user (ADR 0019). Its password is
# the Mac Mini's SECRETS_DIR/rabbitmq/olympus-dev.password; hasura-dev's
# admin secret is SECRETS_DIR/hasura_dev_admin_secret. For the laptop's own
# stack, use local.env (`pnpm dev:local`, local.env.example).

# Distinct per agent, so several can run from the IDE at once.
LISTEN_PORT=3102

# Logging
LOKI_URL=
LOKI_LEVEL=info
LOKI_LOGGING_LEVEL=info
CONSOLE_LOGGING_LEVEL=info
# ENABLE_CONSOLE_LOGGING=true
# FILE_LOGGING_ENABLED=false
# FILE_LOGGING_LEVEL=info
# FILE_LOGGING_PATH=./logs

# RabbitMQ
AMQP_PROTOCOL=amqp
AMQP_HOST=olympus.dev.ncfritz.net
AMQP_PORT=5672
AMQP_USER=olympus-dev
AMQP_PASSWORD=
AMQP_VHOST=/dionysus-dev

# Olympus
API_BASE_URL=http://localhost:3001/v1
# The API's mTLS listener (ADR 0018). `scripts/dev-ca.sh` writes a
# throwaway certificate for this agent.
# API_BASE_URL=https://localhost:3443/v1
# API_CLIENT_CERT=../../infra/dev-ca/certs/agents/dionysus-asset-agent.crt
# API_CLIENT_KEY=../../infra/dev-ca/certs/agents/dionysus-asset-agent.key
# API_CA_CERT=../../infra/dev-ca/certs/services-ca.crt
# The NAS deployment uses its own certificate (OU=nas) and reaches the API
# by name: dionysus-asset-agent-nas.crt / .key.

# Tools
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
HANDBRAKE_PATH=/usr/bin/HandBrakeCLI

# Media workflows: local work directory, shared staging directory, and
# "local" to skip copying between them
LOCAL_DIRECTORY=
STAGING_DIRECTORY=
# DEPLOYMENT_MODE=local
# TRANSCODE_CLEANUP=true

# CDN and library (SFTP)
DIONYSUS_CDN_BASE_URL=
DIONYSUS_CDN_SSH_HOST=
DIONYSUS_CDN_SSH_USERNAME=
DIONYSUS_CDN_SSH_PASSWORD=
DIONYSUS_LIBRARY_SSH_HOST=
DIONYSUS_LIBRARY_SSH_USERNAME=
DIONYSUS_LIBRARY_SSH_PASSWORD=
# DIONYSUS_SKIP_SSH_UPLOAD=true
# DIONYSUS_SKIP_CDN_DOWNLOAD=true

# Downloads: NZBGeek and NZBGet
NZBGEEK_API_KEY=
NZBGET_HOST=
NZBGET_PORT=6789
NZBGET_USERNAME=
NZBGET_PASSWORD=
# PERSIST_EVENTS=true
# EVENTS_DIRECTORY=

# Content assets
CONTENT_ASSETS_DIR=
CONTENT_ASSETS_DOWNLOAD_DIR=
CONTENT_ASSETS_TEMP_DIR=
CONTENT_SSH_HOST=
CONTENT_SSH_USERNAME=
CONTENT_SSH_PASSWORD=

# SOCKS proxy for content downloads (optional)
SOCKS_PROXY_HOST=
SOCKS_PROXY_PORT=
SOCKS_PROXY_USERNAME=
SOCKS_PROXY_PASSWORD=

# Handlers are all enabled; set DISABLE_<HANDLER>=true to turn one off
# (see src/AppModule.ts), e.g.
# DISABLE_CONTENT_HLS_HANDLER=true
