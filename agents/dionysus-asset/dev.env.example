# Copy to dev.env / local.env / production.env (all git-ignored) and fill in.
# `pnpm dev` reads dev.env, `pnpm dev:local` reads local.env.

# Logging
LOKI_URL=
LOKI_LEVEL=info
LOKI_LOGGING_LEVEL=info
CONSOLE_LOGGING_LEVEL=info
# ENABLE_CONSOLE_LOGGING=true
# FILE_LOGGING_ENABLED=false
# FILE_LOGGING_LEVEL=info
# FILE_LOGGING_PATH=./logs

# RabbitMQ
AMQP_PROTOCOL=amqp
AMQP_HOST=localhost
AMQP_PORT=5672
AMQP_USER=
AMQP_PASSWORD=
AMQP_VHOST=/dionysus-dev

# Olympus
API_BASE_URL=http://localhost:3001/v1

# Tools
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
HANDBRAKE_PATH=/usr/bin/HandBrakeCLI

# Media workflows: local work directory, shared staging directory, and
# "local" to skip copying between them
LOCAL_DIRECTORY=
STAGING_DIRECTORY=
# DEPLOYMENT_MODE=local
# TRANSCODE_CLEANUP=true

# CDN and library (SFTP)
DIONYSUS_CDN_BASE_URL=
DIONYSUS_CDN_SSH_HOST=
DIONYSUS_CDN_SSH_USERNAME=
DIONYSUS_CDN_SSH_PASSWORD=
DIONYSUS_LIBRARY_SSH_HOST=
DIONYSUS_LIBRARY_SSH_USERNAME=
DIONYSUS_LIBRARY_SSH_PASSWORD=
# DIONYSUS_SKIP_SSH_UPLOAD=true
# DIONYSUS_SKIP_CDN_DOWNLOAD=true

# Downloads: NZBGeek and NZBGet
NZBGEEK_API_KEY=
NZBGET_HOST=
NZBGET_PORT=6789
NZBGET_USERNAME=
NZBGET_PASSWORD=
# PERSIST_EVENTS=true
# EVENTS_DIRECTORY=

# Content assets
CONTENT_ASSETS_DIR=
CONTENT_ASSETS_DOWNLOAD_DIR=
CONTENT_ASSETS_TEMP_DIR=
CONTENT_SSH_HOST=
CONTENT_SSH_USERNAME=
CONTENT_SSH_PASSWORD=

# SOCKS proxy for content downloads (optional)
SOCKS_PROXY_HOST=
SOCKS_PROXY_PORT=
SOCKS_PROXY_USERNAME=
SOCKS_PROXY_PASSWORD=

# Handlers are all enabled; set DISABLE_<HANDLER>=true to turn one off
# (see src/module/AppModule.ts), e.g.
# DISABLE_TEST_HANDLER=true
