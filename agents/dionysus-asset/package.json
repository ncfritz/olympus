{
  "name": "@ncfritz/dionysus-asset-agents",
  "description": "Asynchronous agent for handling content and media assets",
  "version": "0.0.0",
  "private": true,
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint src test",
    "lintfix": "eslint src test --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "analyze": "RSDOCTOR=true nest build",
    "start": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=dev.env dist/main.js",
    "start:local": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=local.env dist/main.js",
    "start:prod": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=production.env dist/main.js",
    "dev": "NODE_EXTRA_CA_CERTS=./ca_roots.pem nest start --env-file dev.env --watch",
    "dev:local": "NODE_EXTRA_CA_CERTS=./ca_roots.pem nest start --env-file local.env --watch",
    "dev:prod": "NODE_EXTRA_CA_CERTS=./ca_roots.pem nest start --env-file production.env --watch"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "catalog:",
    "@ncfritz/olympus-messages": "workspace:*",
    "@ncfritz/olympus-nest": "workspace:*",
    "@ncfritz/olympus-sdk": "workspace:*",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "^11.1.23",
    "@nestjs/schedule": "^6.1.3",
    "axios": "^1.16.1",
    "cli-progress": "^3.12.0",
    "fast-xml-parser": "^5.8.0",
    "ffmpeg-on-progress": "^1.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "m3u8-parser": "^7.2.0",
    "moment": "catalog:",
    "nest-winston": "catalog:",
    "node-html-parser": "^7.1.0",
    "object-to-spawn-args": "^2.0.1",
    "progress-stream": "^2.0.0",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "sharp": "^0.34.5",
    "socks-proxy-agent": "^10.0.0",
    "source-map-support": "^0.5.21",
    "ssh2-sftp-client": "^12.1.1",
    "subparse": "^0.0.1",
    "uuid": "^14.0.0",
    "winston": "catalog:",
    "winston-daily-rotate-file": "catalog:",
    "winston-loki": "catalog:"
  },
  "devDependencies": {
    "@ncfritz/olympus-config": "workspace:*",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "catalog:",
    "@rsdoctor/webpack-plugin": "^1.5.15",
    "@swc/core": "catalog:",
    "@types/amqplib": "^0.10.8",
    "@types/cli-progress": "^3.11.6",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "catalog:",
    "@types/progress-stream": "^2.0.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "ts-loader": "^9.5.7",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
