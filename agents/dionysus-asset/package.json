{
  "name": "@ncfritz/dionysus-asset-agents",
  "version": "1.0.1",
  "main": "dist/main.js",
  "scripts": {
    "prepare": "is-ci || husky install",
    "clean": "rimraf dist && rimraf tsconfig.tsbuildinfo",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "lint": "eslint ./src",
    "lintfix": "eslint ./src --fix",
    "start": "NODE_ENV=dev NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=dev.env dist/main",
    "start:local": "NODE_ENV=local NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=local.env dist/main",
    "start:prod": "NODE_ENV=production NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=production.env dist/main",
    "dev": "NODE_ENV=dev NODE_EXTRA_CA_CERTS=./ca_roots.pem nest --env-file=dev.env start --watch",
    "dev:local": "NODE_ENV=dev NODE_EXTRA_CA_CERTS=./ca_roots.pem nest --env-file=local.env start --watch"
  },
  "dependencies": {
    "@golevelup/nestjs-graphql-request": "^0.2.5",
    "@golevelup/nestjs-rabbitmq": "^6.0.2",
    "@ncfritz/olympus-sdk": "^1.0.9",
    "@nestjs/apollo": "^13.2.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.8",
    "@nestjs/graphql": "^13.2.0",
    "@nestjs/platform-express": "^11.1.8",
    "@nestjs/swagger": "^11.2.1",
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/hls-parser": "^0.8.7",
    "@types/n-readlines": "^1.0.6",
    "@types/progress-stream": "^2.0.5",
    "@types/ssh2-sftp-client": "^9.0.5",
    "@types/uuid": "^11.0.0",
    "apollo-server-express": "^3.13.0",
    "axios": "^1.13.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cli-progress": "^3.12.0",
    "cookie-parser": "^1.4.7",
    "ffmpeg-on-progress": "^1.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "graphql": "^16.12.0",
    "hls-parser": "^0.15.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "m3u8-parser": "^7.2.0",
    "moment": "^2.30.1",
    "n-readlines": "^1.0.1",
    "nestjs-metrics-reporter": "^1.9.1",
    "node-html-parser": "^7.0.1",
    "object-to-spawn-args": "^2.0.1",
    "pretty-ms": "^9.3.0",
    "progress-stream": "^2.0.0",
    "reflect-metadata": "^0.2.2",
    "sanitize": "^2.1.2",
    "sharp": "^0.34.5",
    "socks-proxy-agent": "^8.0.5",
    "ssh2-sftp-client": "^12.0.1",
    "subparse": "^0.0.1",
    "tmdb-ts": "^2.0.2",
    "uuid": "^11.1.0",
    "winston": "^3.18.3",
    "winston-loki": "^6.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@semantic-release/git": "^10.0.1",
    "@types/cli-progress": "^3.11.6",
    "@types/express": "^5.0.5",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "commitizen": "^4.3.1",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "rxjs": "^7.8.2",
    "semantic-release": "^24.2.7",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.41.0"
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "prettier",
      "plugin:prettier/recommended"
    ],
    "env": {
      "node": true
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
