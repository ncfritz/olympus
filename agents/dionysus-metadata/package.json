{
  "name": "@ncfritz/dionysus-metadata-agents",
  "version": "1.3.3",
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ncfritz/dionysus-metadata-agents.git"
  },
  "readmeFilename": "README.md",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "prepare": "is-ci || husky install",
    "clean": "rm -rf ./dist",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "lint": "eslint ./src",
    "lintfix": "eslint ./src --fix",
    "start": "NODE_ENV=dev NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=dev.env dist/main",
    "start:local": "NODE_ENV=local NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=local.env dist/main",
    "start:prod": "NODE_ENV=production NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=production.env dist/main",
    "dev": "NODE_ENV=dev NODE_EXTRA_CA_CERTS=./ca_roots.pem nest --env-file=dev.env start --watch",
    "dev:local": "NODE_ENV=dev NODE_EXTRA_CA_CERTS=./ca_roots.pem nest --env-file=local.env start --watch"
  },
  "dependencies": {
    "@golevelup/nestjs-graphql-request": "^0.2.5",
    "@golevelup/nestjs-rabbitmq": "^6.0.2",
    "@ncfritz/olympus-sdk": "latest",
    "@nestjs/apollo": "^13.1.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.2",
    "@nestjs/graphql": "^13.1.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@types/amqplib": "^0.10.7",
    "@types/cookie-parser": "^1.4.8",
    "@types/n-readlines": "^1.0.6",
    "@types/uuid": "^10.0.0",
    "apollo-server-express": "^3.13.0",
    "axios": "^1.11.0",
    "better-sqlite3": "^12.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "graphql": "^16.11.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "moment": "^2.30.1",
    "n-readlines": "^1.0.1",
    "nestjs-metrics-reporter": "^1.9.1",
    "nest-winston": "^1.10.2",
    "node-lmdb": "^0.10.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "tmdb-ts": "^2.0.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-loki": "^6.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@semantic-release/git": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "commitizen": "^4.3.1",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "semantic-release": "^24.2.7",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
