{
  "name": "@ncfritz/dionysus-metadata-agents",
  "version": "1.0.0",
  "main": "build/dist/main.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "lint": "eslint ./src",
    "lintfix": "eslint ./src --fix",
    "start": "NODE_ENV=local NODE_EXTRA_CA_CERTS=./ca_roots.pem nest start",
    "start:prod": "NODE_ENV=dev NODE_EXTRA_CA_CERTS=./ca_roots.pem node --inspect build/dist/main",
    "dev": "NODE_ENV=dev NODE_EXTRA_CA_CERTS=./ca_roots.pem nest start --watch",
    "dev:local": "NODE_ENV=local NODE_EXTRA_CA_CERTS=./ca_roots.pem nest start --watch"
  },
  "dependencies": {
    "@golevelup/nestjs-graphql-request": "^0.2.5",
    "@golevelup/nestjs-rabbitmq": "^6.0.1",
    "@nestjs/apollo": "^13.1.0",
    "@nestjs/common": "^11.1.2",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.2",
    "@nestjs/graphql": "^13.1.0",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@types/amqplib": "^0.10.7",
    "@types/cookie-parser": "^1.4.8",
    "@types/n-readlines": "^1.0.6",
    "@types/uuid": "^10.0.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "apollo-server-express": "^3.13.0",
    "axios": "^1.9.0",
    "better-sqlite3": "^11.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "graphql": "^16.11.0",
    "moment": "^2.30.1",
    "n-readlines": "^1.0.1",
    "nest-winston": "^1.10.2",
    "node-lmdb": "^0.10.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "tmdb-ts": "^2.0.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-loki": "^6.1.3"
  },
  "devDependencies": {
    "@ncfritz/olympus-model": "^1.5.0",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.29",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "prettier": "^3.5.3",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.8.3"
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "prettier",
      "plugin:prettier/recommended"
    ],
    "env": {
      "node": true
