{
  "name": "@ncfritz/dionysus-search-agents",
  "description": "Asynchronous agent for handling media searches",
  "main": "dist/main.js",
  "version": "1.4.5",
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "readmeFilename": "README.md",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ncfritz/dionysus-search-agents.git"
  },
  "scripts": {
    "prepare": "is-ci || husky install",
    "clean": "rimraf dist && rimraf tsconfig.tsbuildinfo",
    "analyze": "RSDOCTOR=true npm run build",
    "prebuild": "rimraf dist",
    "build": "rspack build",
    "lint": "eslint ./src",
    "lintfix": "eslint ./src --fix",
    "start": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=dev.env dist/main",
    "start:local": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=local.env dist/main",
    "start:prod": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=production.env dist/main",
    "dev": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=dev.env node_modules/.bin/rspack dev",
    "dev:local": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=local.env node_modules/.bin/rspack dev"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "^9.0.2",
    "@ncfritz/olympus-sdk": "latest",
    "@nestjs/common": "^11.1.23",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.23",
    "@types/amqplib": "^0.10.8",
    "cookie-parser": "^1.4.7",
    "nest-winston": "^1.10.2",
    "nestjs-metrics-reporter": "^1.10.1",
    "signal-exit": "^4.1.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-loki": "^6.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@golevelup/nestjs-graphql-request": "^5.0.0",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/platform-express": "^11.1.23",
    "@nestjs/schematics": "^11.1.0",
    "@rsdoctor/rspack-plugin": "^1.5.11",
    "@rspack/core": "^2.0.4",
    "@rspack/cli": "^2.0.4",
    "@rspack/dev-server": "^2.0.1",
    "@semantic-release/git": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^25.9.1",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "axios": "^1.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "commitizen": "^4.3.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "moment": "^2.30.1",
    "prettier": "^3.8.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "run-script-webpack-plugin": "^0.2.3",
    "rxjs": "^7.8.2",
    "semantic-release": "^25.0.3",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "uuid": "^14.0.0",
    "webpack-node-externals": "^3.0.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
