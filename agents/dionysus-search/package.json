{
  "name": "@ncfritz/dionysus-search-agents",
  "description": "Asynchronous agent for handling media searches",
  "version": "0.0.0",
  "private": true,
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "lintfix": "eslint src --fix",
    "clean": "rm -rf dist",
    "analyze": "RSDOCTOR=true nest build",
    "start": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=dev.env dist/main.js",
    "start:local": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=local.env dist/main.js",
    "start:prod": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=production.env dist/main.js",
    "dev": "NODE_EXTRA_CA_CERTS=./ca_roots.pem nest start --env-file dev.env --watch",
    "dev:local": "NODE_EXTRA_CA_CERTS=./ca_roots.pem nest start --env-file local.env --watch",
    "dev:prod": "NODE_EXTRA_CA_CERTS=./ca_roots.pem nest start --env-file production.env --watch"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "catalog:",
    "@ncfritz/olympus-sdk": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "^11.1.23",
    "axios": "^1.16.1",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "cookie-parser": "^1.4.7",
    "moment": "catalog:",
    "nest-winston": "catalog:",
    "nestjs-metrics-reporter": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "signal-exit": "^4.1.0",
    "source-map-support": "^0.5.21",
    "winston": "catalog:",
    "winston-daily-rotate-file": "catalog:",
    "winston-loki": "catalog:"
  },
  "devDependencies": {
    "@ncfritz/olympus-config": "workspace:*",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@rsdoctor/webpack-plugin": "^1.5.15",
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "prom-client": "^15.1.3",
    "ts-loader": "^9.5.7",
    "typescript": "catalog:"
  }
}
