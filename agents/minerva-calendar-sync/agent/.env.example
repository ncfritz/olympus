DATABASE_URL="file:./dev.db"

# From a Google Cloud "Desktop app" OAuth client (see the setup walkthrough).
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# JSON array of { provider: "google", accountLabel, calendarId, source }.
# accountLabel must match a credential saved by `pnpm google:auth -- --label <label>`.
SYNCED_CALENDARS='[]'

# How often each configured calendar is polled, in milliseconds.
POLL_INTERVAL_MS=45000

# --- App login (distinct from the Google Calendar-access OAuth above) ---

# Secret used to sign this app's own access/refresh JWTs. Generate one with
# `openssl rand -base64 32`. Changing it invalidates every issued token.
AUTH_JWT_SECRET=""

# Where this API is reachable — used to build the exact OIDC redirect_uri,
# which must match what's registered with each provider below.
AUTH_BASE_URL="http://localhost:3000"

# JSON array of { name, issuer, clientId, clientSecret } — one entry per
# OIDC provider accepted for login. From a "Web application" OAuth client
# (NOT the Desktop app client used for calendar access) with
# {AUTH_BASE_URL}/auth/callback/{name} registered as an authorized redirect URI.
AUTH_OIDC_PROVIDERS='[]'

# Comma-separated list of verified emails allowed to log in. Anyone else is
# rejected even if the identity provider itself authenticates them.
AUTH_ALLOWED_EMAILS=""
