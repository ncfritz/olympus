DATABASE_URL="file:./dev.db"

# For Postgres instead (prod, or to run the same app against the real
# thing locally): `docker compose up -d postgres` (repo root) gives you one
# at the URL below for free. Then, before starting the app:
#   pnpm --filter api prisma:generate:postgres
#   pnpm --filter api prisma:deploy:postgres
# The client is generated from whichever schema you last pointed it at
# (prisma/schema.prisma vs prisma/postgres/schema.prisma) — always
# re-generate after switching DATABASE_URL between the two, or Prisma will
# reject the connection string as the wrong dialect.
# DATABASE_URL="postgresql://minerva:minerva@localhost:5432/minerva"

# From a Google Cloud "Desktop app" OAuth client (see the setup walkthrough).
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# JSON array of { provider: "google", accountLabel, calendarId, source, enablePush? }.
# accountLabel must match a credential saved by `pnpm google:auth -- --label <label>`.
# enablePush (default false) additionally registers a Google push channel for
# that calendar — requires WEBHOOK_BASE_URL below. Polling always stays on
# regardless, as the safety net push delivery isn't guaranteed to replace.
SYNCED_CALENDARS='[]'

# How often each configured calendar is polled, in milliseconds.
POLL_INTERVAL_MS=45000

# How long a sync-history entry (Sync page > history) is kept before being
# pruned, in days. Only "meaningful" runs are recorded in the first place
# (something changed, it errored, or it was manually triggered), so this is
# a backstop rather than the primary defense against unbounded growth.
SYNC_HISTORY_RETENTION_DAYS=90

# A real, publicly reachable HTTPS origin Google's servers can POST to for
# push notifications (e.g. an ngrok/Cloudflare Tunnel URL in dev). Only
# needed if any calendar above has enablePush: true; plain HTTP and
# localhost are never accepted by Google for this. Leave unset to run
# polling-only.
WEBHOOK_BASE_URL=""

# --- App login (distinct from the Google Calendar-access OAuth above) ---

# Secret used to sign this app's own access/refresh JWTs. Generate one with
# `openssl rand -base64 32`. Changing it invalidates every issued token.
AUTH_JWT_SECRET=""

# Where this API is reachable — used to build the exact OIDC redirect_uri,
# which must match what's registered with each provider below.
AUTH_BASE_URL="http://localhost:4432"

# JSON array of { name, issuer, clientId, clientSecret } — one entry per
# OIDC provider accepted for login. From a "Web application" OAuth client
# (NOT the Desktop app client used for calendar access) with
# {AUTH_BASE_URL}/auth/callback/{name} registered as an authorized redirect URI.
AUTH_OIDC_PROVIDERS='[]'

# Comma-separated list of verified emails allowed to log in. Anyone else is
# rejected even if the identity provider itself authenticates them.
AUTH_ALLOWED_EMAILS=""

# The web app's own origin (apps/web). Enables CORS with credentials for it,
# and is the only origin /auth/login's returnTo is allowed to redirect to.
WEB_APP_URL="http://localhost:4392"
