# Which calendars to sync is app config, not env config — connect an
# account and add its calendars from the Sync page (or POST /calendar-accounts,
# POST /calendars) once the OAuth client credentials below are set. It's
# stored in this database, takes effect immediately, and needs no restart.
#
# local.env (`pnpm dev:local`) runs this service from the IDE on the laptop,
# against the laptop's own stack (infra/docker, env/laptop.env): Hasura on
# localhost:8080 and RabbitMQ's /dionysus-dev vhost as the olympus-dev
# user, whose password is the laptop's SECRETS_DIR/rabbitmq/olympus-dev.password.
DATABASE_URL="file:./dev.db"

# For Postgres instead (prod, or to run the same app against the real
# thing locally): `docker compose up -d postgres` (agents/minerva-calendar-sync) gives you one
# at the URL below for free. Then, before starting the app:
#   pnpm --filter @ncfritz/minerva-calendar-sync-agent prisma:generate:postgres
#   pnpm --filter @ncfritz/minerva-calendar-sync-agent prisma:deploy:postgres
# The client is generated from whichever schema you last pointed it at
# (prisma/schema.prisma vs prisma/postgres/schema.prisma) — always
# re-generate after switching DATABASE_URL between the two, or Prisma will
# reject the connection string as the wrong dialect.
# DATABASE_URL="postgresql://minerva:minerva@localhost:5432/minerva"

# From a Google Cloud "Desktop app" OAuth client (see the setup walkthrough).
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# From a Microsoft Entra ID app registration (Azure Portal > App registrations
# > New registration): platform "Mobile and desktop applications" with
# redirect URI http://localhost (the exact loopback port is chosen at runtime
# and doesn't need to be pre-registered), and delegated Microsoft Graph
# permission Calendars.Read (+ offline_access, openid, email — usually
# granted by default). This registration type is always a *public* client —
# PKCE is its security story, and Entra ID rejects a token request that also
# carries a client secret — so there is no MICROSOFT_OAUTH_CLIENT_SECRET to
# set, even if the portal generated one for the app registration.
MICROSOFT_OAUTH_CLIENT_ID=""
# "common" accepts both work/school and personal Microsoft accounts. Use a
# specific Entra ID tenant id (or "organizations") to restrict sign-in to it.
MICROSOFT_OAUTH_TENANT_ID="common"

# How often each configured calendar is polled, in milliseconds.
POLL_INTERVAL_MS=45000

# How far back and forward a full sync fetches events, in days. A full sync
# asks the provider to expand recurring series into their individual
# occurrences (Google's singleEvents, Microsoft's calendarView) — that
# expansion only works over a bounded range, hence a window rather than
# "sync everything". SyncEngine re-establishes it via a fresh full sync once
# a day, so it stays a rolling window rather than a fixed one.
SYNC_WINDOW_PAST_DAYS=30
SYNC_WINDOW_FUTURE_DAYS=180

# How long a sync-history entry (Sync page > history) is kept before being
# pruned, in days. Only "meaningful" runs are recorded in the first place
# (something changed, it errored, or it was manually triggered), so this is
# a backstop rather than the primary defense against unbounded growth.
SYNC_HISTORY_RETENTION_DAYS=90

# A real, publicly reachable HTTPS origin Google's/Microsoft's servers can
# POST to for push notifications (e.g. an ngrok/Cloudflare Tunnel URL in
# dev). Only needed if any calendar above has enablePush: true; plain HTTP
# and localhost are never accepted by either provider for this. Leave unset
# to run polling-only.
WEBHOOK_BASE_URL=""

# Publish local event changes onward (to Olympus, ADR 0013) through a
# durable outbox — see OutboxModule — to the "calendar.events" topic
# exchange with routing keys "event.upsert" / "event.delete" /
# "event.backfill". When false nothing else in this app depends on it, and
# no connection to RabbitMQ is even attempted.
OUTBOX_ENABLED=false
# The broker, read only when OUTBOX_ENABLED=true.
AMQP_PROTOCOL=amqp
AMQP_HOST=localhost
AMQP_PORT=5672
AMQP_USER=olympus-dev
AMQP_PASSWORD=
AMQP_VHOST=/dionysus-dev
# Dispatcher tuning (defaults shown).
# OUTBOX_BATCH_SIZE=50
# OUTBOX_POLL_INTERVAL_MS=5000
# OUTBOX_MAX_ATTEMPTS=10

# --- App login (distinct from the Google Calendar-access OAuth above) ---

# Secret used to sign this app's own access/refresh JWTs. Generate one with
# `openssl rand -base64 32`. Changing it invalidates every issued token.
AUTH_JWT_SECRET=""

# Where this API is reachable — used to build the exact OIDC redirect_uri,
# which must match what's registered with each provider below.
AUTH_BASE_URL="http://localhost:4432"

# JSON array of { name, issuer, clientId, clientSecret } — one entry per
# OIDC provider accepted for login. From a "Web application" OAuth client
# (NOT the Desktop app client used for calendar access) with
# {AUTH_BASE_URL}/auth/callback/{name} registered as an authorized redirect URI.
AUTH_OIDC_PROVIDERS='[]'

# Comma-separated list of verified emails allowed to log in. Anyone else is
# rejected even if the identity provider itself authenticates them.
AUTH_ALLOWED_EMAILS=""

# The console's own origin (../console). Enables CORS with credentials for it,
# and is the only origin /auth/login's returnTo is allowed to redirect to.
WEB_APP_URL="http://localhost:4392"

# --- Server and logging ---

# LISTEN_PORT=4432
# NODE_ENV=development
# CONSOLE_LOGGING_LEVEL=info
# LOKI_URL=
# LOKI_LOGGING_LEVEL=info
# FILE_LOGGING_ENABLED=false
