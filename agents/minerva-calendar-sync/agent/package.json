{
  "name": "@ncfritz/minerva-calendar-sync-agent",
  "description": "Minerva calendar sync agent: syncs Google and Microsoft 365 calendars, publishes changes, and serves its management API",
  "version": "0.0.0",
  "private": true,
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "license": "Apache-2.0",
  "scripts": {
    "prebuild": "rimraf dist && prisma generate",
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "pretest": "prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "pretest:integration": "npm run prisma:generate:postgres",
    "test:integration": "jest --config ./test/jest-integration.json",
    "posttest:integration": "npm run prisma:generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate:postgres": "prisma generate --schema=prisma/postgres/schema.prisma",
    "prisma:migrate:postgres": "prisma migrate dev --schema=prisma/postgres/schema.prisma",
    "prisma:deploy:postgres": "prisma migrate deploy --schema=prisma/postgres/schema.prisma",
    "google:auth": "ts-node -r tsconfig-paths/register scripts/google-oauth-setup.ts",
    "google:verify": "ts-node -r tsconfig-paths/register scripts/google-verify-sync.ts",
    "openapi:generate": "ts-node -r tsconfig-paths/register scripts/generate-openapi.ts",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "catalog:",
    "@prisma/client": "^6.19.3",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^11.0.2",
    "googleapis": "^180.0.0",
    "openid-client": "^6.8.8",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@ncfritz/olympus-config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "catalog:",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "dotenv": "^17.4.2",
    "eslint": "catalog:",
    "jest": "^30.5.1",
    "js-yaml": "^5.4.2",
    "prettier": "catalog:",
    "prisma": "^6.19.3",
    "rimraf": "^6.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "catalog:",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "catalog:"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/test/unit"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
