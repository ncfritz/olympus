{
  "name": "@ncfritz/minerva-calendar-sync-agent",
  "description": "Minerva calendar sync agent: syncs Google and Microsoft 365 calendars, publishes changes, and serves its management API",
  "version": "0.0.0",
  "private": true,
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "license": "Apache-2.0",
  "scripts": {
    "prebuild": "rimraf dist && prisma generate",
    "build": "nest build",
    "start": "node --env-file=dev.env dist/main",
    "dev": "nest start --env-file dev.env --watch",
    "start:debug": "nest start --env-file dev.env --debug --watch",
    "start:prod": "node --env-file=production.env dist/main",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "pretest": "prisma generate",
    "test": "vitest run --project unit --project e2e",
    "test:e2e": "vitest run --project e2e",
    "test:integration": "prisma generate --schema=prisma/postgres/schema.prisma && vitest run --project integration; status=$?; prisma generate; exit $status",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node --env-file=dev.env node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "node --env-file=dev.env node_modules/prisma/build/index.js migrate deploy",
    "prisma:generate:postgres": "prisma generate --schema=prisma/postgres/schema.prisma",
    "prisma:migrate:postgres": "node --env-file=dev.env node_modules/prisma/build/index.js migrate dev --schema=prisma/postgres/schema.prisma",
    "prisma:deploy:postgres": "node --env-file=dev.env node_modules/prisma/build/index.js migrate deploy --schema=prisma/postgres/schema.prisma",
    "google:auth": "node --env-file=dev.env -r ts-node/register -r tsconfig-paths/register scripts/google-oauth-setup.ts",
    "google:verify": "node --env-file=dev.env -r ts-node/register -r tsconfig-paths/register scripts/google-verify-sync.ts",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --project e2e --coverage",
    "start:local": "node --env-file=local.env dist/main",
    "openapi": "node dist/openapi.js openapi",
    "check:openapi": "rm -rf .openapi-check && node dist/openapi.js .openapi-check > /dev/null && diff -r openapi .openapi-check && rm -rf .openapi-check",
    "lint:openapi": "spectral lint \"openapi/*.json\" --fail-severity=error",
    "check:conventions": "pnpm check:openapi && pnpm lint:openapi"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "catalog:",
    "@ncfritz/olympus-messages": "workspace:*",
    "@ncfritz/olympus-model": "workspace:*",
    "@ncfritz/olympus-nest": "workspace:*",
    "nestjs-metrics-reporter": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "catalog:",
    "@prisma/client": "^6.19.3",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^11.0.2",
    "googleapis": "^180.0.0",
    "moment": "catalog:",
    "nest-winston": "catalog:",
    "openid-client": "^6.8.8",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "source-map-support": "^0.5.21",
    "winston": "catalog:",
    "winston-daily-rotate-file": "catalog:",
    "winston-loki": "catalog:"
  },
  "devDependencies": {
    "@ncfritz/olympus-config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "catalog:",
    "@stoplight/spectral-cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "prisma": "^6.19.3",
    "rimraf": "^6.0.1",
    "supertest": "catalog:",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
