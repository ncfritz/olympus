{
  "name": "@minerva/api",
  "version": "0.0.1",
  "description": "Calendar sync agent + API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "pretest": "prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "pretest:integration": "npm run prisma:generate:postgres",
    "test:integration": "jest --config ./test/jest-integration.json",
    "posttest:integration": "npm run prisma:generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate:postgres": "prisma generate --schema=prisma/postgres/schema.prisma",
    "prisma:migrate:postgres": "prisma migrate dev --schema=prisma/postgres/schema.prisma",
    "prisma:deploy:postgres": "prisma migrate deploy --schema=prisma/postgres/schema.prisma",
    "google:auth": "ts-node -r tsconfig-paths/register scripts/google-oauth-setup.ts",
    "google:verify": "ts-node -r tsconfig-paths/register scripts/google-verify-sync.ts",
    "openapi:generate": "ts-node -r tsconfig-paths/register scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "^9.0.2",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^11.0.2",
    "googleapis": "^180.0.0",
    "openid-client": "^6.8.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.1",
    "js-yaml": "^5.4.2",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "rimraf": "^6.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/test/unit"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
