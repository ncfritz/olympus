// Postgres counterpart of ../schema.prisma, kept in sync deliberately by
// hand rather than generated — Prisma has no way to share model
// definitions across two `datasource` blocks with different `provider`s in
// one file. The two files' model bodies must stay identical (a unit test
// in test/unit/domain asserts this); only the `datasource` block differs.
// Selected explicitly via `--schema` (see the `*:postgres` scripts in
// package.json) — the default `prisma/schema.prisma` (SQLite) is what dev
// and the regular test suite use unless you opt into this one.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id             String   @id
  source         String
  uid            String
  subject        String
  sensitivity    String
  importance     String
  occurrenceType String
  type           String
  reminder       Boolean
  response       String
  startTime      DateTime
  endTime        DateTime
  duration       Int
  allDay         Boolean
  status         String
  location       String?
  cancelled      Boolean  @default(false)
  organizerEmail String?
  deleted        Boolean  @default(false)
  recurrenceId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([source, uid], name: "source_uid")
  @@index([source, deleted])
}

// Per-calendar incremental sync cursor + push-channel bookkeeping.
model SyncState {
  calendarId        String    @id
  syncToken         String?
  channelId         String?
  resourceId        String?
  channelExpiration DateTime?
  channelToken      String?
  updatedAt         DateTime  @updatedAt
}

// Per-meeting availability override, keyed by the canonical event id
// ("source:uid") rather than a foreign key into Event — deliberately not a
// Prisma relation, so this survives Event being fully wiped and re-synced.
model EventOverride {
  eventId   String   @id
  status    String
  updatedAt DateTime @updatedAt
}

// An independent block of time on the internal "Overrides" calendar (not
// tied to any synced meeting) that overrides the computed availability
// status for everything it covers.
model OverrideBlock {
  id        String   @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  status    String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startTime, endTime])
}
