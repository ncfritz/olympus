{
  "extends": "@ncfritz/olympus-config/tsconfig/nest.json",
  "compilerOptions": {
    // Built with tsc (nest build), not webpack: Prisma's client and engines
    // stay in node_modules. CommonJS output, as before the import.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "isolatedModules": false,
    // Stricter than the workspace preset, as the source repo was.
    "strict": true,
    "strictPropertyInitialization": false,
    "noUnusedLocals": false,
    "noImplicitReturns": false,
    // Tests and scripts are type-checked with the sources (Jest, ts-node).
    "rootDir": "${configDir}",
    "types": ["node", "jest"],
    "incremental": true
  },
  "include": [
    "${configDir}/src/**/*.ts",
    "${configDir}/test/**/*.ts",
    "${configDir}/scripts/**/*.ts"
  ],
  "exclude": []
}
