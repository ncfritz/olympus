# Copy to dev.env (git-ignored) and fill in; `uv run --env-file dev.env
# minerva-mail-ml` reads it. Paths are from agents/minerva-mail-ml.

# The plain listener: /health and /metrics only.
LISTEN_PORT=3106
LOG_LEVEL=info
ENVIRONMENT=development

# The feature store (git-ignored): hashed counts, never text.
FEATURE_STORE_PATH=data/features.sqlite3
# Model runs and models (git-ignored).
MODEL_DIR=data/models

# The services listener, where the mail agent sends text: mutual TLS with
# certificates from the services issuer, and only the services named in
# SERVICES_ALLOWED_CLIENTS. `scripts/dev-ca.sh` writes the certificates.
# Leave these unset and there is no services listener at all.
SERVICES_LISTEN_PORT=3107
TLS_CERT=../../infra/dev-ca/certs/minerva-mail-ml.crt
TLS_KEY=../../infra/dev-ca/certs/minerva-mail-ml.key
TLS_CA_SERVICES=../../infra/dev-ca/certs/services-ca.crt
TLS_CRL_SERVICES=../../infra/dev-ca/certs/services.crl,../../infra/dev-ca/certs/intermediate-2.crl,../../infra/dev-ca/certs/root.crl
SERVICES_ISSUER=ncfritz.net Dev Service Issuing CA 1 - G1
SERVICES_ALLOWED_CLIENTS=minerva-mail-agent

# Training reads metadata and labels from the API's mTLS listener with the
# classifier's own client certificate; the API needs minerva-mail-ml:agent in
# AUTH_SERVICE_ROLES. Leave these unset and nothing can be trained.
API_BASE_URL=https://localhost:3443/v1
API_CLIENT_CERT=../../infra/dev-ca/certs/agents/minerva-mail-ml.crt
API_CLIENT_KEY=../../infra/dev-ca/certs/agents/minerva-mail-ml.key
API_CA_CERT=../../infra/dev-ca/certs/services-ca.crt

# With the API set, the service learns from approvals in the inbox this
# often (seconds) and scores the inbox again after; 0 turns it off.
LEARN_SECONDS=60
