# Copy to dev.env / local.env (git-ignored) and fill in.
# `pnpm dev` reads dev.env, `pnpm dev:local` reads local.env.
#
# Phase 1a of docs/plans/email-management: the Takeout import publishes to
# the broker and imports the account through the API. dev.env feeds
# olympus_dev through a dev API run from the IDE, on the Mac Mini's
# /dionysus-dev vhost as the olympus-dev user. Its password is the Mac
# Mini's SECRETS_DIR/rabbitmq/olympus-dev.password.

LISTEN_PORT=3105

# Logging
LOKI_URL=
LOKI_LEVEL=info
LOKI_LOGGING_LEVEL=info
CONSOLE_LOGGING_LEVEL=info
# ENABLE_CONSOLE_LOGGING=true
# FILE_LOGGING_ENABLED=false

# RabbitMQ: where mail.messages is published.
AMQP_PROTOCOL=amqp
AMQP_HOST=olympus.dev.ncfritz.net
AMQP_PORT=5672
AMQP_USER=olympus-dev
AMQP_PASSWORD=
AMQP_VHOST=/dionysus-dev

# Olympus: the dev API's services listener. Importing the account is an
# agent's operation, so it needs this agent's certificate
# (`scripts/dev-ca.sh` writes one), and the dev API needs
# minerva-mail-agent:agent in AUTH_SERVICE_ROLES.
API_BASE_URL=https://localhost:3443/v1
API_CLIENT_CERT=../../infra/dev-ca/certs/agents/minerva-mail-agent.crt
API_CLIENT_KEY=../../infra/dev-ca/certs/agents/minerva-mail-agent.key
API_CA_CERT=../../infra/dev-ca/certs/services-ca.crt

# The classifier (agents/minerva-mail-ml), for `takeout featurize`: its
# services listener, over mutual TLS. The agent's own certificate (the
# API_CLIENT_* above) is used unless MAIL_ML_CLIENT_CERT and _KEY are set.
MAIL_ML_URL=https://localhost:3107/v1
# MAIL_ML_TIMEOUT_MS=60000

# Gmail (phase 1b): the mail agent's own OAuth client, a Web application
# client in the calendar agent's Google project on its Internal consent
# screen. The client ID is not a secret; the secret is a file holding only
# the secret, outside the repository. Refresh tokens are kept one file per
# mailbox in MAIL_CREDENTIALS_DIR (git-ignored).
MAIL_GOOGLE_OAUTH_CLIENT_ID=728437817202-5l0vdb4qtilolkotif8bcrs4vl9i26s8.apps.googleusercontent.com
MAIL_GOOGLE_OAUTH_CLIENT_SECRET_FILE=
MAIL_CREDENTIALS_DIR=data/credentials

# The services listener, which only the API calls (to link a mailbox):
# the agent's server certificate from `scripts/dev-ca.sh`, and the API's
# client certificate (agents/olympus-api.*) is what gets in.
SERVICES_LISTEN_PORT=4435
TLS_CERT=../../infra/dev-ca/certs/minerva-mail-agent.crt
TLS_KEY=../../infra/dev-ca/certs/minerva-mail-agent.key
TLS_CA_SERVICES=../../infra/dev-ca/certs/services-ca.crt
TLS_CRL_SERVICES=../../infra/dev-ca/certs/services.crl,../../infra/dev-ca/certs/intermediate-2.crl,../../infra/dev-ca/certs/root.crl
AUTH_SERVICES_ISSUER=ncfritz.net Dev Service Issuing CA 1 - G1
# AUTH_SERVICE_CLIENTS=olympus-api
