# Copy to dev.env / local.env (git-ignored) and fill in.
# `pnpm dev` reads dev.env, `pnpm dev:local` reads local.env.
#
# Phase 0 of docs/plans/email-management: the agent only serves /metrics.
# The broker, the API and the Takeout import arrive with phase 1a.

LISTEN_PORT=3105

# Logging
LOKI_URL=
LOKI_LEVEL=info
LOKI_LOGGING_LEVEL=info
CONSOLE_LOGGING_LEVEL=info
# ENABLE_CONSOLE_LOGGING=true
# FILE_LOGGING_ENABLED=false
