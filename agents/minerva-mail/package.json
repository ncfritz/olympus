{
  "name": "@ncfritz/minerva-mail-agent",
  "description": "Syncs a Gmail mailbox's labels and message metadata into Minerva, from a Takeout archive or the Gmail API, and writes reviewed label changes back (ADR 0030)",
  "version": "0.0.0",
  "private": true,
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "files": [
    "dist",
    "ca_roots.pem"
  ],
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint src test",
    "lintfix": "eslint src test --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "start": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=dev.env dist/main.js",
    "start:local": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=local.env dist/main.js",
    "dev": "NODE_EXTRA_CA_CERTS=./ca_roots.pem nest start --env-file dev.env --watch",
    "takeout": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file-if-exists=dev.env dist/takeout.js",
    "takeout:prod": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=prod.env dist/takeout.js",
    "gmail": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file-if-exists=dev.env dist/gmail.js",
    "dev:local": "NODE_EXTRA_CA_CERTS=./ca_roots.pem nest start --env-file local.env --watch"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "catalog:",
    "@ncfritz/olympus-client": "workspace:*",
    "@ncfritz/olympus-messages": "workspace:*",
    "@ncfritz/olympus-nest": "workspace:*",
    "@ncfritz/olympus-sdk": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "^11.1.23",
    "axios": "catalog:",
    "google-auth-library": "^11.1.0",
    "nest-winston": "catalog:",
    "postal-mime": "^4.0.4",
    "prom-client": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "source-map-support": "^0.5.21",
    "winston": "catalog:",
    "winston-daily-rotate-file": "catalog:",
    "winston-loki": "catalog:"
  },
  "devDependencies": {
    "@ncfritz/olympus-config": "workspace:*",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "catalog:",
    "@swc/core": "catalog:",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "ts-loader": "^9.5.7",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
