# Copy to prod.env (git-ignored) and fill in: the Takeout commands against
# prod, from the repository (`pnpm --filter @ncfritz/minerva-mail-agent
# takeout:prod import ...`). The running agent is the olympus stack's
# (infra/docker/compose/olympus.yml); this file is only for the archive,
# which is read in place on this machine.
#
# Prod's resources over the LAN: the broker (5672) and the API's mTLS
# listener (3443), which the NAS uses too, and the classifier's services
# listener (3107). The identity is the mail agent's own: its client
# certificate and its broker user, from prod's SECRETS_DIR.
LOKI_URL=
CONSOLE_LOGGING_LEVEL=info

AMQP_PROTOCOL=amqp
AMQP_HOST=snowball.desktop.ncfritz.net
AMQP_PORT=5672
AMQP_VHOST=/dionysus
AMQP_USER=minerva-mail-agent
AMQP_PASSWORD_FILE=/Users/ncfritz/Docker/secrets/olympus/rabbitmq/minerva-mail-agent.password

API_BASE_URL=https://api.olympus.internal.ncfritz.net:3443/v1
API_CLIENT_CERT=/Users/ncfritz/Docker/secrets/olympus/tls/minerva-mail-agent/client.crt
API_CLIENT_KEY=/Users/ncfritz/Docker/secrets/olympus/tls/minerva-mail-agent/client.key
API_CA_CERT=/Users/ncfritz/Docker/secrets/olympus/tls/minerva-mail-agent/services-ca.crt

# The classifier, with the same client certificate. Its listener's
# certificate names snowball.desktop.ncfritz.net and localhost.
MAIL_ML_URL=https://snowball.desktop.ncfritz.net:3107/v1
