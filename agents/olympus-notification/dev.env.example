# Copy to dev.env / local.env / production.env (all git-ignored) and fill in.
# `pnpm dev` reads dev.env, `pnpm dev:local` reads local.env.
#
# dev.env (`pnpm dev`) runs this service from the IDE in the home lab,
# against the Mac Mini's dev infrastructure: hasura-dev and RabbitMQ's
# /dionysus-dev vhost as the olympus-dev user (ADR 0019). Its password is
# the Mac Mini's SECRETS_DIR/rabbitmq/olympus-dev.password; hasura-dev's
# admin secret is SECRETS_DIR/hasura_dev_admin_secret. For the laptop's own
# stack, use local.env (`pnpm dev:local`, local.env.example).

LISTEN_PORT=3101

# Logging
LOKI_URL=
LOKI_LEVEL=info
LOKI_LOGGING_LEVEL=info
CONSOLE_LOGGING_LEVEL=info
# ENABLE_CONSOLE_LOGGING=true
# FILE_LOGGING_ENABLED=false
# FILE_LOGGING_LEVEL=info
# FILE_LOGGING_PATH=./logs

# RabbitMQ
AMQP_PROTOCOL=amqp
AMQP_HOST=olympus.dev.ncfritz.net
AMQP_PORT=5672
AMQP_USER=olympus-dev
AMQP_PASSWORD=
AMQP_VHOST=/dionysus-dev

# Olympus
WSS_HOST=ws://localhost:3001
API_BASE_URL=http://localhost:3100/v1
# The API's mTLS listener (ADR 0018). `scripts/dev-ca.sh` writes a
# throwaway certificate for this agent.
# API_BASE_URL=https://localhost:3443/v1
# API_CLIENT_CERT=../../infra/dev-ca/certs/agents/olympus-notification-agent.crt
# API_CLIENT_KEY=../../infra/dev-ca/certs/agents/olympus-notification-agent.key
# API_CA_CERT=../../infra/dev-ca/certs/services-ca.crt

# Synology SMTP
SYNO_SMTP_HOST=
SYNO_SMTP_USER=
SYNO_SMTP_PASSWORD=

# Synology Chat webhooks (a destination without a token is skipped)
# SYNO_CHAT_HOST=https://nfs02.sea.ncfritz.net
SYNO_CHAT_OLYMPUS_BOT_TOKEN=
SYNO_CHAT_OLYMPUS_CHANNEL_TOKEN=

# Gmail SMTP (app password)
# GMAIL_USER=ncfritz@ncfritz.net
GMAIL_APP_PASSWORD=
