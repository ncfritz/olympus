{
  "name": "@ncfritz/olympus-notification-agent",
  "description": "Asynchronous agent for handling Olympus notifications",
  "version": "0.0.0",
  "private": true,
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint src test",
    "lintfix": "eslint src test --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "analyze": "RSDOCTOR=true nest build",
    "start": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=dev.env dist/main.js",
    "start:local": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=local.env dist/main.js",
    "start:prod": "NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=production.env dist/main.js",
    "dev": "NODE_EXTRA_CA_CERTS=./ca_roots.pem nest start --env-file dev.env --watch",
    "dev:local": "NODE_EXTRA_CA_CERTS=./ca_roots.pem nest start --env-file local.env --watch",
    "dev:prod": "NODE_EXTRA_CA_CERTS=./ca_roots.pem nest start --env-file production.env --watch"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "catalog:",
    "@ncfritz/olympus-messages": "workspace:*",
    "@ncfritz/olympus-nest": "workspace:*",
    "@ncfritz/olympus-sdk": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "^11.1.23",
    "axios": "^1.16.1",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "cookie-parser": "^1.4.7",
    "handlebars": "^4.7.9",
    "handlebars-helpers": "^0.10.0",
    "moment": "catalog:",
    "nest-winston": "catalog:",
    "nodemailer": "^8.0.7",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "uuid": "^14.0.0",
    "winston": "catalog:",
    "winston-daily-rotate-file": "catalog:",
    "winston-loki": "catalog:"
  },
  "devDependencies": {
    "@ncfritz/olympus-config": "workspace:*",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "catalog:",
    "@rsdoctor/webpack-plugin": "^1.5.16",
    "@swc/core": "catalog:",
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/handlebars-helpers": "^0.5.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.0",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "catalog:",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "ts-loader": "^9.5.7",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
