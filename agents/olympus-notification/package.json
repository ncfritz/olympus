{
  "name": "@ncfritz/olympus-notification-agent",
  "description": "Asynchronous agent for handling Olympus notifications",
  "version": "1.2.0",
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ncfritz/olympus-notification-agent.git"
  },
  "readmeFilename": "README.md",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "prepare": "is-ci || husky install",
    "clean": "rm -rf ./dist && rm tsconfig.tsbuildinfo",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "lint": "eslint ./src",
    "lintfix": "eslint ./src --fix",
    "start": "NODE_ENV=dev NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=dev.env dist/main",
    "start:local": "NODE_ENV=local NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=local.env dist/main",
    "start:prod": "NODE_ENV=production NODE_EXTRA_CA_CERTS=./ca_roots.pem node --env-file=production.env dist/main",
    "dev": "NODE_ENV=dev NODE_EXTRA_CA_CERTS=./ca_roots.pem nest --env-file=dev.env start --watch",
    "dev:local": "NODE_ENV=dev NODE_EXTRA_CA_CERTS=./ca_roots.pem nest --env-file=local.env start --watch"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "^6.0.1",
    "@ncfritz/olympus-sdk": "latest",
    "@nestjs/apollo": "^13.1.0",
    "@nestjs/common": "^11.1.2",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.2",
    "@nestjs/platform-express": "^11.1.2",
    "@types/amqplib": "^0.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "axios": "^1.11.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "handlebars": "^4.7.8",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "moment": "^2.30.1",
    "nest-winston": "^1.10.2",
    "nestjs-metrics-reporter": "^1.9.1",
    "nodemailer": "^7.0.3",
    "prom-client": "^15.1.3",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0",
    "winston-loki": "^6.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@semantic-release/git": "^10.0.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.29",
    "commitizen": "^4.3.1",
    "conventional-changelog-conventionalcommits": "^9.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.4.1",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "semantic-release": "^24.2.5",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
