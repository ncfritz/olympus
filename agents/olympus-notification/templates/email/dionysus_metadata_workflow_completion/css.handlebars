.title {
  font-size: 20px;
  margin-bottom: 8px;
}
.monospace {
  font-family: "Courier New", Courier, monospace;
}
.stepInfo td {
  font-size: 12px;
  padding-bottom: 2px;
  border-bottom: 1px solid #efefef;
}
.stats td {
  font-size: 12px;
}
.jobType {
  font-size: 11px;
  text-align: right;
  vertical-align: middle;
}
.summary {
  margin-bottom: 16px;
  font-size: 14px;
}
.summary td {
  vertical-align: middle;
}
.step td {
  padding-top: 16px;
}
.status {
  min-width: 100px;
  border-radius: 4px;
  text-align: center;
  font-size: 11px;
  display: inline;
  padding: 2px;
}
table.progress {
  border-collapse: collapse;
  padding-left: 8px;
}
table.progress td {
  height: 10px;
  border: none;
  vertical-align: center;
}
.success {
  color: #ffffff;
  background-color: #006400;
}
.failure {
  color: #ffffff;
  background-color: #8B0000;
}
.r-noop {
  background-color: #e55471;
}
.r-skipped {
  background-color: #f4a002;
}
.r-expired {
  background-color: #764f90;
}
.r-new {
  background-color: #023e5a;
}
.r-duplicate {
  background-color: #ffcc33;
}
