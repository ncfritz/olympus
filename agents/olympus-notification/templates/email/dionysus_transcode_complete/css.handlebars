.wrapper {
  padding: 0 !important;
}
.innerWrapper {
  padding: 12px !important;
}
.title {
  font-size: 20px;
  margin-bottom: 8px;
}
.monospace {
  font-family: "Courier New", Courier, monospace;
}
.poster {
  width: 100%;
  text-align: center;
  padding: 32px 0;
  background: #87909a;
}
.poster img {
  border-radius: 6px !important;
}
.stepInfo td {
  font-size: 12px;
  padding-bottom: 2px;
  border-bottom: 1px solid #efefef;
}
.stats td {
  font-size: 12px;
}
.summary {
  margin-bottom: 16px;
  font-size: 14px;
}
.summary td {
  vertical-align: middle;
}
.step td {
  padding-top: 16px;
}
.status {
  min-width: 150px;
  border-radius: 4px;
  text-align: center;
  font-size: 11px;
  display: inline;
  padding: 2px 6px;
}
.success {
  color: #ffffff;
  background-color: #006400;
}
.skipped {
  color: #ffffff;
  background-color: #833683;
}
.failure {
  color: #ffffff;
  background-color: #8B0000;
}
