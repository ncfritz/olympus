# Copy to dev.env / local.env (git-ignored) and fill in.
# `pnpm dev` reads dev.env, `pnpm dev:local` reads local.env.
#
# The relay feeds one database through that environment's API (ADR 0025):
# dev.env feeds olympus_dev through a dev API run from the IDE, against the
# Mac Mini's /dionysus-dev vhost as the olympus-dev user. Its password is
# the Mac Mini's SECRETS_DIR/rabbitmq/olympus-dev.password.

LISTEN_PORT=3102

# Logging
LOKI_URL=
LOKI_LEVEL=info
LOKI_LOGGING_LEVEL=info
CONSOLE_LOGGING_LEVEL=info
# ENABLE_CONSOLE_LOGGING=true
# FILE_LOGGING_ENABLED=false

# RabbitMQ: prod's weather lines arrive on /dionysus-dev by the broker's
# shovel, whichever broker this environment otherwise uses.
AMQP_PROTOCOL=amqp
AMQP_HOST=olympus.dev.ncfritz.net
AMQP_PORT=5672
AMQP_USER=olympus-dev
AMQP_PASSWORD=
AMQP_VHOST=/dionysus-dev

# The database fed, which names the queue (weather.station.reports.<name>).
# Relays feeding the same database share a queue; one with a database of
# its own (a laptop's) names it here and gets every line too.
WEATHER_RELAY_DATABASE=olympus_dev

# Olympus: the dev API's services listener. The import is an agent's, so
# it needs this agent's certificate (`scripts/dev-ca.sh` writes one), and
# the dev API needs olympus-weather-relay-agent:agent in AUTH_SERVICE_ROLES.
API_BASE_URL=https://localhost:3443/v1
API_CLIENT_CERT=../../infra/dev-ca/certs/agents/olympus-weather-relay-agent.crt
API_CLIENT_KEY=../../infra/dev-ca/certs/agents/olympus-weather-relay-agent.key
API_CA_CERT=../../infra/dev-ca/certs/services-ca.crt
