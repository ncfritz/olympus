# Copy to dev.env / local.env / production.env (all git-ignored) and fill in.
# `pnpm dev` reads dev.env, `pnpm dev:local` reads local.env.

LISTEN_PORT=3001
ENABLE_API_EXPLORER=true
# CORS_ORIGINS=http://localhost:3000

# Authentication (ADR 0018). `report` counts what it would refuse and
# serves the request anyway; `enforce` refuses it.
AUTH_MODE_USERS=report
AUTH_MODE_SERVICES=report
# AUTH_SERVICE_ROLES=dionysus-asset-agent:agent|content,dionysus-search-agent:agent
# The mTLS listener starts only when all three of TLS_CERT, TLS_KEY and
# TLS_CA_SERVICES are set. `scripts/dev-ca.sh` writes a throwaway set.
# SERVICES_LISTEN_PORT=3443
# TLS_CERT=../../infra/dev-ca/certs/api.crt
# TLS_KEY=../../infra/dev-ca/certs/api.key
# TLS_CA_SERVICES=../../infra/dev-ca/certs/services-ca.crt
# TLS_CRL_SERVICES=../../infra/dev-ca/certs/services.crl,../../infra/dev-ca/certs/root.crl

# Logging
LOKI_URL=
LOKI_LEVEL=info
CONSOLE_LOGGING_LEVEL=info
# ENABLE_CONSOLE_LOGGING=true
# FILE_LOGGING_ENABLED=false
# FILE_LOGGING_LEVEL=info
# FILE_LOGGING_PATH=./logs

# Hasura
HASURA_PROTOCOL=http
HASURA_HOST=localhost
HASURA_PORT=8080
HASURA_PASSWORD=

# RabbitMQ
AMQP_PROTOCOL=amqp
AMQP_HOST=localhost
AMQP_PORT=5672
AMQP_USER=
AMQP_PASSWORD=
AMQP_VHOST=/dionysus

# Dionysus file handling (required)
DIONYSUS_UPLOAD_PATH=
DIONYSUS_PUBLISH_PATH=
