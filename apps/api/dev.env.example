# Copy to dev.env / local.env / production.env (all git-ignored) and fill in.
# `pnpm dev` reads dev.env, `pnpm dev:local` reads local.env.
#
# dev.env (`pnpm dev`) runs this service from the IDE in the home lab,
# against the Mac Mini's dev infrastructure: hasura-dev and RabbitMQ's
# /dionysus-dev vhost as the olympus-dev user (ADR 0019). Its password is
# the Mac Mini's SECRETS_DIR/rabbitmq/olympus-dev.password; hasura-dev's
# admin secret is SECRETS_DIR/hasura_dev_admin_secret. For the laptop's own
# stack, use local.env (`pnpm dev:local`, local.env.example).

LISTEN_PORT=3001
ENABLE_API_EXPLORER=true
# CORS_ORIGINS=http://localhost:3000

# Nothing sits in front of this, so nobody's X-Forwarded-For is believed and
# the auth rate limits count each caller by its own address. Behind nginx,
# set this (see infra/docker/env/prod/olympus-api.env).
# TRUSTED_PROXIES=uniquelocal

# Authentication (ADR 0018). `report` counts what it would refuse and
# serves the request anyway; `enforce` refuses it.
AUTH_MODE_USERS=report
AUTH_MODE_SERVICES=report
# The services that may call it, by certificate common name.
# AUTH_SERVICE_ROLES=dionysus-asset-agent:agent,dionysus-metadata-agent:agent,dionysus-search-agent:agent,olympus-notification-agent:agent
# Signing in (docs/guides/signing-in.md). Unset, signing in is unavailable
# rather than broken, which is how every environment behaves until it is
# configured.
# A directory of ES256 PEMs; every key verifies, the last by filename signs.
# `scripts/signing-keys.sh <directory>` writes one.
# AUTH_SIGNING_KEYS=/Users/you/olympus-secrets/auth-signing-keys
# One canonical base, including any path the API is published under. It
# decides the callback URL registered with each provider and the path the
# refresh cookie is scoped to, so it is not whichever origin someone
# arrived on. The port has to match LISTEN_PORT above.
# AUTH_PUBLIC_BASE_URL=http://localhost:3001
# Where the site is served, for exact redirect-URI matching. Only the site
# client needs it; the loopback tester does not.
# AUTH_CLIENT_ORIGINS=https://olympus.ncfritz.net,https://olympus.internal.ncfritz.net
# The providers, as JSON: [{ name, issuer, clientId, clientSecret }]. A file
# rather than a value because it holds client secrets; EnvReader reads any
# variable from its _FILE twin.
# AUTH_OIDC_PROVIDERS_FILE=/Users/you/olympus-secrets/oidc-providers.json

# The mTLS listener starts only when all three of TLS_CERT, TLS_KEY and
# TLS_CA_SERVICES are set. `scripts/dev-ca.sh` writes a throwaway set.
# SERVICES_LISTEN_PORT=3443
# TLS_CERT=../../infra/dev-ca/certs/api.crt
# TLS_KEY=../../infra/dev-ca/certs/api.key
# TLS_CA_SERVICES=../../infra/dev-ca/certs/services-ca.crt
# TLS_CRL_SERVICES=../../infra/dev-ca/certs/services.crl,../../infra/dev-ca/certs/root.crl

# Logging
LOKI_URL=
LOKI_LEVEL=info
CONSOLE_LOGGING_LEVEL=info
# ENABLE_CONSOLE_LOGGING=true
# FILE_LOGGING_ENABLED=false
# FILE_LOGGING_LEVEL=info
# FILE_LOGGING_PATH=./logs

# Hasura
HASURA_PROTOCOL=http
HASURA_HOST=olympus.dev.ncfritz.net
HASURA_PORT=8081
HASURA_PASSWORD=

# RabbitMQ
AMQP_PROTOCOL=amqp
AMQP_HOST=olympus.dev.ncfritz.net
AMQP_PORT=5672
AMQP_USER=olympus-dev
AMQP_PASSWORD=
AMQP_VHOST=/dionysus-dev

# Dionysus file handling (required)
DIONYSUS_UPLOAD_PATH=
DIONYSUS_PUBLISH_PATH=
