# Copy to local.env (all git-ignored) and fill in.
# `pnpm dev:local` reads it.
#
# local.env (`pnpm dev:local`) runs this service from the IDE on the laptop,
# against the laptop's own stack (infra/docker, env/laptop.env): Hasura on
# localhost:8080 and RabbitMQ's /dionysus-dev vhost as the olympus-dev
# user, whose password is the laptop's SECRETS_DIR/rabbitmq/olympus-dev.password.

LISTEN_PORT=3001
ENABLE_API_EXPLORER=true
# CORS_ORIGINS=http://localhost:3000

# Nothing sits in front of this, so nobody's X-Forwarded-For is believed and
# the auth rate limits count each caller by its own address. Behind nginx,
# set this (see infra/docker/env/prod/olympus-api.env).
# TRUSTED_PROXIES=uniquelocal

# Authentication (ADR 0018). `report` counts what it would refuse and
# serves the request anyway; `enforce` refuses it.
AUTH_MODE_USERS=report
AUTH_MODE_SERVICES=report
# The services that may call it, by certificate common name.
# AUTH_SERVICE_ROLES=dionysus-asset-agent:agent,dionysus-metadata-agent:agent,dionysus-search-agent:agent,olympus-notification-agent:agent
# The mTLS listener starts only when all three of TLS_CERT, TLS_KEY and
# TLS_CA_SERVICES are set. `scripts/dev-ca.sh` writes a throwaway set.
# SERVICES_LISTEN_PORT=3443
# TLS_CERT=../../infra/dev-ca/certs/api.crt
# TLS_KEY=../../infra/dev-ca/certs/api.key
# TLS_CA_SERVICES=../../infra/dev-ca/certs/services-ca.crt
# TLS_CRL_SERVICES=../../infra/dev-ca/certs/services.crl,../../infra/dev-ca/certs/root.crl

# Logging
LOKI_URL=
LOKI_LEVEL=info
CONSOLE_LOGGING_LEVEL=info
# ENABLE_CONSOLE_LOGGING=true
# FILE_LOGGING_ENABLED=false
# FILE_LOGGING_LEVEL=info
# FILE_LOGGING_PATH=./logs

# Hasura
HASURA_PROTOCOL=http
HASURA_HOST=localhost
HASURA_PORT=8080
HASURA_PASSWORD=

# RabbitMQ
AMQP_PROTOCOL=amqp
AMQP_HOST=localhost
AMQP_PORT=5672
AMQP_USER=olympus-dev
AMQP_PASSWORD=
AMQP_VHOST=/dionysus-dev

# Dionysus file handling (required)
DIONYSUS_UPLOAD_PATH=
DIONYSUS_PUBLISH_PATH=
