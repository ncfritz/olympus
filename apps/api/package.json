{
  "name": "@ncfritz/olympus-api",
  "description": "REST API for Olympus",
  "main": "dist/main.js",
  "version": "1.23.1",
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "readmeFilename": "README.md",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ncfritz/olympus-api.git"
  },
  "scripts": {
    "prepare": "is-ci || husky install",
    "clean": "rm -rf ./dist && rimraf tsconfig.tsbuildinfo",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "postbuild": "jest --silent --config jest.config.js apiSpecGenerator",
    "lint": "eslint ./src",
    "lintfix": "eslint ./src --fix",
    "start": "NODE_ENV=local nest start",
    "start:prod": "node dist/main",
    "dev": "NODE_ENV=dev nest start --watch",
    "dev:local": "NODE_ENV=local nest start --watch"
  },
  "dependencies": {},
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@golevelup/nestjs-rabbitmq": "^9.0.2",
    "@ncfritz/olympus-model": "latest",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/common": "^11.1.23",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.23",
    "@nestjs/devtools-integration": "^0.2.1",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/platform-express": "^11.1.23",
    "@nestjs/platform-socket.io": "^11.1.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/testing": "^11.1.23",
    "@nestjs/websockets": "^11.1.23",
    "@semantic-release/git": "^10.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "babel-jest": "^30.4.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "commitizen": "^4.3.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cookie-parser": "^1.4.7",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "graphql": "^16.14.0",
    "graphql-request": "^7.4.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "jose": "^6.2.3",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.2",
    "nest-winston": "^1.10.2",
    "nestjs-metrics-reporter": "^1.10.1",
    "prettier": "^3.8.3",
    "pretty-bytes": "^7.1.0",
    "pretty-ms": "^9.3.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "semantic-release": "^25.0.3",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "speakeasy": "^2.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "uuid": "^14.0.0",
    "webpack-bundle-analyzer": "^5.3.0",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.4"
  },
  "overrides": {
    "@apollo/server": "^5.5.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
