{
  "name": "@ncfritz/olympus-api",
  "description": "REST API for Olympus",
  "version": "0.0.0",
  "private": true,
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "openapi": "node dist/openapi.js openapi",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint src test",
    "lintfix": "eslint src test --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage",
    "check:conventions": "vitest run test/conventions && pnpm check:openapi && pnpm lint:openapi",
    "check:allow-update": "UPDATE_ALLOW_LIST=1 vitest run test/conventions",
    "clean": "rm -rf dist",
    "analyze": "RSDOCTOR=true nest build",
    "start": "node --env-file=dev.env dist/main.js",
    "start:local": "node --env-file=local.env dist/main.js",
    "start:prod": "node --env-file=production.env dist/main.js",
    "dev": "nest start --env-file dev.env --watch",
    "dev:local": "nest start --env-file local.env --watch",
    "dev:prod": "nest start --env-file production.env --watch",
    "check:openapi": "rm -rf .openapi-check && node dist/openapi.js .openapi-check > /dev/null && diff -r openapi .openapi-check && rm -rf .openapi-check",
    "lint:openapi": "spectral lint \"openapi/*.json\" --fail-severity=error"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "catalog:",
    "@ncfritz/olympus-model": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/platform-express": "^11.1.23",
    "@nestjs/swagger": "catalog:",
    "@nestjs/websockets": "^11.1.23",
    "body-parser": "^2.3.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "graphql-request": "^7.4.0",
    "jose": "^6.2.3",
    "moment": "catalog:",
    "moment-timezone": "^0.6.2",
    "multer": "^2.2.0",
    "nest-winston": "^1.10.2",
    "nestjs-metrics-reporter": "^1.10.1",
    "pretty-bytes": "^7.1.0",
    "pretty-ms": "^9.3.0",
    "socket.io": "^4.8.3",
    "source-map-support": "^0.5.21",
    "speakeasy": "^2.0.0",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-loki": "^6.1.4"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@ncfritz/olympus-config": "workspace:*",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/core": "catalog:",
    "@nestjs/devtools-integration": "^0.2.1",
    "@nestjs/platform-socket.io": "^11.1.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "catalog:",
    "@rsdoctor/webpack-plugin": "^1.5.15",
    "@stoplight/spectral-cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/amqplib": "^0.10.8",
    "@types/body-parser": "^1.19.6",
    "@types/connect": "^3.4.38",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "eslint": "catalog:",
    "graphql": "^16.14.0",
    "prettier": "catalog:",
    "prom-client": "^15.1.3",
    "reflect-metadata": "catalog:",
    "run-script-webpack-plugin": "^0.2.3",
    "rxjs": "catalog:",
    "socket.io-client": "^4.8.3",
    "ts-loader": "^9.5.7",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
