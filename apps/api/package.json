{
  "name": "@ncfritz/olympus-api",
  "description": "REST API for Olympus",
  "version": "1.17.3",
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ncfritz/olympus-api.git"
  },
  "readmeFilename": "README.md",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "prepare": "is-ci || husky install",
    "clean": "rm -rf ./dist && rimraf tsconfig.tsbuildinfo",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "postbuild": "jest --silent --config jest.config.js apiSpecGenerator",
    "lint": "eslint ./src",
    "lintfix": "eslint ./src --fix",
    "start": "NODE_ENV=local nest start",
    "start:prod": "node dist/main",
    "dev": "NODE_ENV=dev nest start --watch",
    "dev:local": "NODE_ENV=local nest start --watch"
  },
  "dependencies": {
    "@apollo/server": "^5.2.0",
    "@golevelup/nestjs-rabbitmq": "^6.1.0",
    "@ncfritz/olympus-model": "latest",
    "@nestjs/apollo": "^13.2.3",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/devtools-integration": "^0.2.1",
    "@nestjs/graphql": "^13.2.3",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/websockets": "^11.1.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "graphql": "^16.12.0",
    "graphql-request": "^7.4.0",
    "jose": "^6.1.3",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "nest-winston": "^1.10.2",
    "nestjs-metrics-reporter": "^1.9.2",
    "pretty-bytes": "^7.1.0",
    "pretty-ms": "^9.3.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "speakeasy": "^2.0.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^9.39.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@semantic-release/git": "^10.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.1",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "babel-jest": "^30.2.0",
    "commitizen": "^4.3.1",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jest": "^30.2.0",
    "jest-mock-extended": "^4.0.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "rxjs": "^7.8.2",
    "semantic-release": "^25.0.2",
    "socket.io-client": "^4.8.1",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0"
  },
  "overrides": {
    "@apollo/server": "^5.2.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
