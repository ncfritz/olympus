# Copy to .env (git-ignored) beside docker-compose.yml.
#
# The development Postgres's password: hex, so it needs no escaping in
# DATABASE_URL. `openssl rand -hex 32`. The same value goes in
# service/dev.env's DATABASE_URL.
HARPOCRATES_DEV_POSTGRES_PASSWORD=

# Where it listens: 127.0.0.1 when the service runs on this machine, 0.0.0.0
# to reach it from another (the service on a laptop, Postgres on the Mac Mini).
# HARPOCRATES_DEV_POSTGRES_BIND=0.0.0.0
