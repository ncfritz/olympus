# Optional: copy to .env (git-ignored) beside docker-compose.yml.
#
# Where the development Postgres listens: 127.0.0.1 (the default) when the
# service runs on this machine, 0.0.0.0 to reach it from another (the
# service on a laptop, Postgres on the Mac Mini). Its password is not here:
# it is the secret file .run/postgres-password.
# HARPOCRATES_DEV_POSTGRES_BIND=0.0.0.0
