# Optional: copy to .env (git-ignored) beside docker-compose.yml.
#
# Where the development Postgres's password is: the file
# harpocrates_dev_postgres_password in this directory (`openssl rand -hex 32`),
# beside the stack's secrets as infra/docker/env/*.env name them. Unset, .run/.
# HARPOCRATES_SECRETS_DIR=/Users/ncfritz/Docker/secrets/harpocrates
#
# Where it listens: 127.0.0.1 (the default) when the service runs on this
# machine, 0.0.0.0 to reach it from another (the service on a laptop,
# Postgres on the Mac Mini).
# HARPOCRATES_DEV_POSTGRES_BIND=0.0.0.0
