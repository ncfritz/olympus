# The Harpocrates service, which runs on its own port in the workspace
# (apps/harpocrates/service, LISTEN_PORT=3200). In the image the console
# and the service share an origin and this is left unset: the console asks
# for it at /harpocrates/ca/api (ADR 0021). The service's WEB_APP_URL must
# be this console (http://localhost:4394) for its cookies and CORS.
NEXT_PUBLIC_API_URL="http://localhost:3200"

# The rest of the suite, so the sidebar's other consoles reach the home lab
# rather than 404ing on localhost. Unset is fine.
# CONTROL_ORIGIN="https://control.olympus.internal.ncfritz.net"
