# Two ways to run it in development:
#
# On the development control host (infra/docker/nginx/control-dev.conf),
# as the image runs: one origin, the service under the console. Set the
# base path and leave NEXT_PUBLIC_API_URL unset, so the console asks for
# the service at /harpocrates/ca/api (ADR 0021). basePath is read when
# `next dev` starts.
NEXT_PUBLIC_BASE_PATH=/harpocrates/ca
#
# Or on localhost alone, the service on its own port: no base path, and
# the service's WEB_APP_URL is http://localhost:4394 for its cookies and
# CORS.
# NEXT_PUBLIC_API_URL="http://localhost:3200"

# The rest of the suite, so the sidebar's other consoles reach the home lab
# rather than 404ing on localhost. Unset is fine.
# CONTROL_ORIGIN="https://control.olympus.internal.ncfritz.net"
