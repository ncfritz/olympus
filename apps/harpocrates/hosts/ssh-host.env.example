# harpocrates-ssh-host's settings (docs/guides/ssh.md): copy to
# /etc/harpocrates/ssh-host.env, root's, mode 0644. Nothing here is a
# secret: the host proves itself with its host key.

# The renewal listener: renewal and the KRL, over HTTPS.
HARPOCRATES_RENEWAL_URL=https://pki.internal.ncfritz.net:9443

# The root the renewal listener's certificate chains to, PEM.
HARPOCRATES_CA_FILE=/etc/harpocrates/root.pem

# The host key Harpocrates certified, and its certificate beside it.
HOST_KEY=/etc/ssh/ssh_host_ed25519_key
#HOST_CERTIFICATE=/etc/ssh/ssh_host_ed25519_key-cert.pub

# How sshd picks up a new certificate. macOS starts sshd for each
# connection, so nothing; on a Linux host or the NAS, a restart.
#RESTART_COMMAND="systemctl restart sshd"

# Where sshd_config's RevokedKeys points.
KRL_FILE=/etc/ssh/revoked_keys
