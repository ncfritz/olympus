# Copy to dev.env / production.env (git-ignored) and fill in.
# `pnpm dev` reads dev.env.
#
# Harpocrates keeps its own Postgres (ADR 0020, Data). For development,
# `docker compose up -d` in apps/harpocrates starts harpocrates-postgres
# on 5433, beside the data stack's Postgres, at the URL below, with the
# password in apps/harpocrates/.env (and its host, if it runs elsewhere); then
# `pnpm prisma:deploy` applies the migrations.
DATABASE_URL="postgresql://harpocrates:<password>@localhost:5433/harpocrates"

LISTEN_PORT=3200
ENABLE_API_EXPLORER=true

# The signer (apps/harpocrates/signer): its socket and the shared token,
# the same two it is configured with.
SIGNER_SOCKET_PATH=../.run/signer.sock
SIGNER_TOKEN_FILE=../.run/token

# Users' access tokens are the API's (ADR 0018): verified against its
# published keys, by URL, or from a JWKS file for working without the API.
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
# AUTH_JWKS_FILE=../.run/jwks.json
AUTH_AUDIENCE=olympus-api
# How recent a sign-in escrow export and ceremonies need, in seconds.
AUTH_RECENT_SIGN_IN_SECONDS=300

# The CA console's sign-in through Olympus (ADR 0029, 0032). Without
# OLYMPUS_API_URL only Bearer tokens are taken. The service completes the
# sign-in at {AUTH_BASE_URL}/auth/callback: the API's AUTH_CONSOLE_BASE_URLS
# must name it for harpocrates-ca-console. On the development control host
# (infra/docker/nginx/control-dev.conf):
# OLYMPUS_API_URL=https://olympus.dev.ncfritz.net/api
# AUTH_BASE_URL=https://control.olympus.dev.ncfritz.net/harpocrates/ca/api
# WEB_APP_URL=https://control.olympus.dev.ncfritz.net/harpocrates/ca
# Where a browser reaches the API to sign in, when that is not OLYMPUS_API_URL.
# OLYMPUS_SIGN_IN_URL=
# On localhost alone: AUTH_BASE_URL=http://localhost:3200 and
# WEB_APP_URL=http://localhost:4394 (the console, its cookies and CORS).

# What CA names and published URLs are built from (ADR 0020, Naming,
# Distribution). Development uses its own realm.
PKI_REALM=ncfritz.net Dev
PKI_ORGANIZATION=ncfritz.net
# The distribution host: in development, the nginx in apps/harpocrates's
# docker-compose.yml, serving PKI_PUBLISHED_DIR. Lists are read back
# through it before they count as published.
PKI_DISTRIBUTION_URL=http://localhost:8480
PKI_PUBLISHED_DIR=../.run/published

# Revocation lists (ADR 0020): an online CA's is valid for 7 days and
# re-signed daily and on every revocation; an offline CA's, signed in a
# ceremony, for 13 months. The scheduler runs every 30 seconds (0: off).
# CRL_VALIDITY_HOURS=168
# CRL_REFRESH_HOURS=24
# CRL_OFFLINE_VALIDITY_DAYS=395
# CRL_SCHEDULE_SECONDS=30

# Logging
LOKI_URL=
LOKI_LEVEL=info
CONSOLE_LOGGING_LEVEL=info
# ENABLE_CONSOLE_LOGGING=true
# FILE_LOGGING_ENABLED=false
# FILE_LOGGING_LEVEL=info
# FILE_LOGGING_PATH=./logs
