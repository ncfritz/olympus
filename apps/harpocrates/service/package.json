{
  "name": "@ncfritz/harpocrates-service",
  "description": "Harpocrates, the internal certificate authority: management API, issuance policy, revocation lists, renewal and ACME",
  "version": "0.0.0",
  "private": true,
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "prebuild": "rimraf dist && prisma generate",
    "build": "nest build",
    "openapi": "node dist/openapi.js openapi",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\" openapi-ts.config.ts",
    "lintfix": "eslint \"{src,test}/**/*.ts\" openapi-ts.config.ts --fix",
    "pretest": "prisma generate",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "check:conventions": "pnpm check:openapi && pnpm lint:openapi && pnpm check:signer-client",
    "check:openapi": "rm -rf .openapi-check && node dist/openapi.js .openapi-check > /dev/null && diff -r openapi .openapi-check && rm -rf .openapi-check",
    "lint:openapi": "spectral lint \"openapi/*.json\" --fail-severity=error",
    "generate:signer": "openapi-ts",
    "check:signer-client": "rm -rf .signer-client-check && SIGNER_CLIENT_OUT=.signer-client-check openapi-ts > /dev/null && diff -r src/generated/signer .signer-client-check && rm -rf .signer-client-check",
    "clean": "rm -rf dist",
    "start": "node --env-file=dev.env dist/main.js",
    "start:prod": "node --env-file=production.env dist/main.js",
    "dev": "nest start --env-file dev.env --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node --env-file=dev.env node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "node --env-file=dev.env node_modules/prisma/build/index.js migrate deploy",
    "cli": "node --env-file=dev.env dist/cli.js",
    "test:e2e": "vitest run --project e2e"
  },
  "dependencies": {
    "@ncfritz/olympus-metrics": "workspace:*",
    "@ncfritz/olympus-model": "workspace:*",
    "@ncfritz/olympus-nest": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "^11.1.23",
    "@nestjs/swagger": "catalog:",
    "@peculiar/x509": "^2.1.0",
    "@prisma/client": "^6.19.3",
    "axios": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "jose": "catalog:",
    "moment": "catalog:",
    "nest-winston": "catalog:",
    "prisma": "^6.19.3",
    "prom-client": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "source-map-support": "^0.5.21",
    "winston": "catalog:"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@ncfritz/olympus-config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "catalog:",
    "@stoplight/spectral-cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "rimraf": "^6.0.1",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
