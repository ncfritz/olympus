// Harpocrates's own database (ADR 0020, Data): harpocrates-postgres, not
// the data stack's Postgres, and not tracked by Hasura. Tables, columns,
// foreign keys and constraints; no JSON documents in rows (ADR 0007).
generator client {
  provider = "prisma-client-js"
  // Its own, not @prisma/client's default (node_modules/.prisma/client):
  // in the workspace every package on this Prisma version shares that
  // one, and the Minerva calendar agent's SQLite client would overwrite
  // this one. Imported through src/store/prisma.ts.
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Certificate authorities

enum IssuerTier {
  root
  intermediate
  issuing
}

/// pending: waiting for its certificate (an external parent).
/// active: signs. closed: signs nothing new (its window, or by choice).
/// revoked: its certificate is revoked.
enum IssuerStatus {
  pending
  active
  closed
  revoked
}

/// A root's shape (ADR 0032): what its ceremonies sign.
/// three_tier: intermediates, which sign issuing CAs (path length 2).
/// two_tier: online issuing CAs (path length 1).
/// direct: leaves, with keys it generates (path length 0).
enum IssuerShape {
  three_tier
  two_tier
  direct
}

/// standard: the extensions a profile's rules make. minimal: the key
/// identifiers and nothing else (ADR 0032, a direct root's leaves).
enum ExtensionSet {
  standard
  minimal
}

enum NameConstraintKind {
  permitted
  excluded
}

enum NameType {
  dns
  ip
  email
  uri
  /// A Microsoft user principal name (otherName): certificates only.
  upn
  /// A registeredID (an OID): certificates only.
  registeredId
}

/// A CA. Roots and intermediates are offline: their keys are never in the
/// signer's store. Issuing CAs are online, their keys in the signer.
model Issuer {
  /// The slug: `tls-issuing-1-g1` (ADR 0020, Naming).
  id                     String       @id
  subject                String       @unique
  tier                   IssuerTier
  status                 IssuerStatus
  /// What it is for (`TLS`, `Service`, ...); optional for a root (`Dev`).
  purpose                String?
  /// O, and the start of the CN; null: the CA's configured organisation.
  /// Children take their root's (ADR 0032, Names and settings).
  organization           String?
  /// A root's shape; null for the tiers below.
  shape                  IssuerShape?
  /// When its key was first given back from the offline media and opened
  /// a ceremony: the backup is proved (ADR 0032, a new root).
  provedAt               DateTime?    @map("proved_at")
  /// Discarded before it signed anything: never published, never reused.
  discardedAt            DateTime?    @map("discarded_at")
  /// Imported from another CA product (XCA; ADR 0037).
  importedAt             DateTime?    @map("imported_at")
  number                 Int
  generation             Int
  parentId               String?      @map("parent_id")
  parent                 Issuer?      @relation("IssuerParent", fields: [parentId], references: [id])
  children               Issuer[]     @relation("IssuerParent")
  /// Its parent is outside Harpocrates (a CSR went out).
  external               Boolean      @default(false)
  keyId                  String       @unique @map("key_id") @db.Uuid
  key                    Key          @relation(fields: [keyId], references: [id])
  certificate            Bytes?
  csr                    Bytes?
  serial                 String?
  notBefore              DateTime?    @map("not_before")
  notAfter               DateTime?    @map("not_after")
  pathLength             Int?         @map("path_length")
  /// The longest certificate it may sign, in days.
  maxValidityDays        Int          @map("max_validity_days")
  crlUrl                 String       @map("crl_url")
  caIssuersUrl           String       @map("ca_issuers_url")
  /// Where its OCSP responder answers (ADR 0036): the distribution host's
  /// /ocsp unless set otherwise; a version may put it in certificates.
  ocspUrl                String       @map("ocsp_url")
  nextCrlNumber          BigInt       @default(1) @map("next_crl_number")
  /// A new list is wanted (a revocation, an imported list): the scheduler
  /// signs one at its next run and clears this.
  crlDueAt               DateTime?    @map("crl_due_at")
  /// When its certificate was last written to the published directory.
  certificatePublishedAt DateTime?    @map("certificate_published_at")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  extendedKeyUsages   IssuerExtendedKeyUsage[]
  nameConstraints     IssuerNameConstraint[]
  alternativeNames    IssuerAlternativeName[]
  profileVersions     ProfileVersion[]
  certificates        Certificate[]
  crls                Crl[]
  ceremonies          Ceremony[]
  importedRevocations ImportedRevocation[]
  ocspResponders      OcspResponder[]
  ocspResponses       OcspResponse[]

  @@unique([purpose, tier, number, generation])
  @@map("issuers")
}

model IssuerExtendedKeyUsage {
  issuerId String @map("issuer_id")
  issuer   Issuer @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  oid      String

  @@id([issuerId, oid])
  @@map("issuer_extended_key_usages")
}

model IssuerNameConstraint {
  id       Int                @id @default(autoincrement())
  issuerId String             @map("issuer_id")
  issuer   Issuer             @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  kind     NameConstraintKind
  type     NameType
  value    String

  @@unique([issuerId, kind, type, value])
  @@map("issuer_name_constraints")
}

/// How whoever runs a CA is reached (an email or URI): its issuer
/// alternative name, which a version may put in its leaves (ADR 0034).
model IssuerAlternativeName {
  id       Int      @id @default(autoincrement())
  issuerId String   @map("issuer_id")
  issuer   Issuer   @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  type     NameType
  value    String

  @@unique([issuerId, type, value])
  @@map("issuer_alternative_names")
}

/// An offline CA's key, in the signer for one ceremony.
model Ceremony {
  /// The signer's ceremony id.
  id        String    @id
  issuerId  String    @map("issuer_id")
  issuer    Issuer    @relation(fields: [issuerId], references: [id])
  principal String
  openedAt  DateTime  @default(now()) @map("opened_at")
  closedAt  DateTime? @map("closed_at")

  crls           Crl[]
  ocspResponders OcspResponder[]

  @@map("ceremonies")
}

// ---- Profiles

enum KeyAlgorithm {
  RSA_2048 @map("RSA-2048")
  RSA_3072 @map("RSA-3072")
  RSA_4096 @map("RSA-4096")
  RSA_8192 @map("RSA-8192")
  DSA_2048 @map("DSA-2048")
  DSA_3072 @map("DSA-3072")
  P_256    @map("P-256")
  P_384    @map("P-384")
  P_521    @map("P-521")
  Ed25519
}

/// What a certificate may be (ADR 0020, Profiles): a stable slug, whether
/// it may be chosen, and its versions (ADR 0034).
/// What a profile issues (ADR 0035): X.509 certificates, or OpenSSH ones.
enum ProfileKind {
  x509
  ssh
}

model Profile {
  id            String      @id
  /// Fixed when it is made; a copy keeps it.
  kind          ProfileKind @default(x509)
  description   String
  /// Only for leaves a root signs directly, in its ceremonies.
  directOnly    Boolean     @default(false) @map("direct_only")
  /// Deactivated: nothing new chooses it; what was issued renews as before.
  deactivatedAt DateTime?   @map("deactivated_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  versions        ProfileVersion[]
  enrollments     Enrollment[]
  certificates    Certificate[]
  sshCertificates SshCertificate[]

  @@map("profiles")
}

/// One version of a profile, v1, v2, …: every setting, frozen once made
/// (ADR 0034). A new certificate takes the latest; a renewal keeps its own.
model ProfileVersion {
  id                     String                     @id @default(uuid()) @db.Uuid
  profileId              String                     @map("profile_id")
  profile                Profile                    @relation(fields: [profileId], references: [id])
  version                Int
  /// The default issuer; the operator may choose another that could sign.
  issuerId               String?                    @map("issuer_id")
  issuer                 Issuer?                    @relation(fields: [issuerId], references: [id])
  /// The issuing CA purpose this profile belongs to, to find an issuer.
  issuerPurpose          String                     @map("issuer_purpose")
  keyAlgorithm           KeyAlgorithm               @map("key_algorithm")
  validityDays           Int                        @map("validity_days")
  renewAtDays            Int                        @map("renew_at_days")
  maxKeyAgeDays          Int                        @map("max_key_age_days")
  allowCsr               Boolean                    @map("allow_csr")
  allowGenerated         Boolean                    @map("allow_generated")
  /// PKCS#12 without the chain, SHA-1 and 3DES: the printer.
  legacyExport           Boolean                    @default(false) @map("legacy_export")
  /// How many alternative names a certificate needs, at least.
  minNames               Int                        @default(0) @map("min_names")
  /// A generated key is kept, exportable again (ADR 0032, escrow). Off, it
  /// can be exported once, then it is destroyed.
  escrow                 Boolean                    @default(true)
  /// Whether one request may choose otherwise.
  escrowOverridable      Boolean                    @default(false) @map("escrow_overridable")
  extensions             ExtensionSet               @default(standard)
  /// The certificate's hash; under an Ed25519 issuer, none.
  signatureHash          CertificateHash            @default(sha256) @map("signature_hash")
  /// Under an RSA issuer; any other ignores it.
  rsaPadding             RsaPadding                 @default(pkcs1v15) @map("rsa_padding")
  subjectKeyIdentifier   KeyIdentifierMethod        @default(sha1) @map("subject_key_identifier")
  authorityKeyIdentifier AuthorityKeyIdentifierForm @default(key_id) @map("authority_key_identifier")
  basicConstraints       BasicConstraintsForm       @default(critical) @map("basic_constraints")
  /// The issuer's CRL distribution point.
  includeCrlDistribution Boolean                    @default(true) @map("include_crl_distribution")
  /// AIA caIssuers: where the issuer's certificate is.
  includeCaIssuers       Boolean                    @default(true) @map("include_ca_issuers")
  /// The issuer's alternative names, where it has any.
  includeIssuerAltName   Boolean                    @default(false) @map("include_issuer_alt_name")
  /// The issuing CA's OCSP URL in the AIA (ADR 0036).
  includeOcsp            Boolean                    @default(false) @map("include_ocsp")
  /// OCSP must-staple: the TLS feature with status_request (RFC 7633).
  mustStaple             Boolean                    @default(false) @map("must_staple")
  /// Who made this version: a principal, or `migration` for the seeds.
  createdBy              String                     @map("created_by")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")

  keyUsages          ProfileKeyUsage[]
  extendedKeyUsages  ProfileExtendedKeyUsage[]
  nameTypes          ProfileNameType[]
  subjectAttributes  ProfileSubjectAttribute[]
  namePolicies       ProfileNamePolicy[]
  keyAlgorithms      ProfileKeyAlgorithm[]
  csrHashes          ProfileCsrHash[]
  policies           ProfilePolicy[]
  customExtensions   ProfileCustomExtension[]
  /// An SSH version's own settings; none for an X.509 one.
  ssh                ProfileSshSettings?
  sshSourceAddresses ProfileSshSourceAddress[]
  sshExtensions      ProfileSshExtension[]
  sshCertificates    SshCertificate[]
  enrollments        Enrollment[]
  certificates       Certificate[]

  @@unique([profileId, version])
  @@map("profile_versions")
}

/// A usage's state in a version (ADR 0034); one not listed is excluded.
enum UsageState {
  /// Always in the certificate.
  forced
  /// In it unless the request removes it.
  default
  /// Out of it unless the request (or its CSR) adds it.
  optional
}

model ProfileKeyUsage {
  profileVersionId String         @map("profile_version_id") @db.Uuid
  profileVersion   ProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)
  usage            String
  state            UsageState     @default(forced)

  @@id([profileVersionId, usage])
  @@map("profile_key_usages")
}

model ProfileExtendedKeyUsage {
  profileVersionId String         @map("profile_version_id") @db.Uuid
  profileVersion   ProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)
  oid              String
  state            UsageState     @default(forced)

  @@id([profileVersionId, oid])
  @@map("profile_extended_key_usages")
}

/// Whether a version allows, or requires, a name type; one not listed is
/// excluded.
enum NamePresence {
  allowed
  required
}

/// The subject alternative name types a profile version allows.
model ProfileNameType {
  profileVersionId String         @map("profile_version_id") @db.Uuid
  profileVersion   ProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)
  type             NameType
  presence         NamePresence   @default(allowed)

  @@id([profileVersionId, type])
  @@map("profile_name_types")
}

/// Whether a subject attribute is required, optional or excluded.
enum AttributePresence {
  required
  optional
  excluded
}

/// A version's rule for one subject DN attribute (ADR 0034); an attribute
/// not listed is excluded.
model ProfileSubjectAttribute {
  profileVersionId String            @map("profile_version_id") @db.Uuid
  profileVersion   ProfileVersion    @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)
  /// Its OID, dotted.
  oid              String
  presence         AttributePresence
  /// What it is when the request gives none.
  defaultValue     String?           @map("default_value")
  /// Whether the default is the only value it may take.
  locked           Boolean           @default(false)
  /// A regular expression each value must match, whole.
  pattern          String?
  /// How many values it may take.
  maxCount         Int               @default(1) @map("max_count")

  @@id([profileVersionId, oid])
  @@map("profile_subject_attributes")
}

/// A version's name policy: subtrees a request's names must lie in
/// (permitted, if any are) and outside (excluded), per type (ADR 0034).
model ProfileNamePolicy {
  id               Int                @id @default(autoincrement())
  profileVersionId String             @map("profile_version_id") @db.Uuid
  profileVersion   ProfileVersion     @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)
  type             NameType
  kind             NameConstraintKind
  value            String

  @@unique([profileVersionId, type, kind, value])
  @@map("profile_name_policies")
}

/// The key types a version allows a request; none listed, any.
model ProfileKeyAlgorithm {
  profileVersionId String         @map("profile_version_id") @db.Uuid
  profileVersion   ProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)
  algorithm        KeyAlgorithm

  @@id([profileVersionId, algorithm])
  @@map("profile_key_algorithms")
}

/// The hashes a CSR's signature may use; none listed, any.
model ProfileCsrHash {
  profileVersionId String         @map("profile_version_id") @db.Uuid
  profileVersion   ProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)
  /// sha1, sha224, sha256, sha384 or sha512.
  hash             String

  @@id([profileVersionId, hash])
  @@map("profile_csr_hashes")
}

enum CertificateHash {
  sha256
  sha384
  sha512
}

enum RsaPadding {
  pkcs1v15
  pss
}

/// RFC 5280's SHA-1 of the key's bits, RFC 7093's truncated SHA-256, or
/// no subject key identifier.
enum KeyIdentifierMethod {
  sha1
  sha256
  none
}

enum AuthorityKeyIdentifierForm {
  key_id
  key_id_and_issuer
  none
}

/// A leaf's basic constraints (CA:FALSE).
enum BasicConstraintsForm {
  critical
  non_critical
  omitted
}

/// A certificate policy a version's certificates assert, in order.
model ProfilePolicy {
  id               Int            @id @default(autoincrement())
  profileVersionId String         @map("profile_version_id") @db.Uuid
  profileVersion   ProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)
  position         Int
  oid              String
  cpsUri           String?        @map("cps_uri")
  userNotice       String?        @map("user_notice")

  @@unique([profileVersionId, oid])
  @@map("profile_policies")
}

/// An extension the signer does not build itself, by OID, its value DER.
model ProfileCustomExtension {
  id               Int            @id @default(autoincrement())
  profileVersionId String         @map("profile_version_id") @db.Uuid
  profileVersion   ProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)
  oid              String
  critical         Boolean        @default(false)
  value            Bytes

  @@unique([profileVersionId, oid])
  @@map("profile_custom_extensions")
}

// ---- SSH (ADR 0035)

/// A user certificate lets its holder log in as its principals; a host
/// certificate vouches for a host's names.
enum SshCertificateType {
  user
  host
}

enum SshCaStatus {
  /// New certificates come from the newest active generation of a type.
  active
  /// Signs nothing more; trusted until its certificates have expired.
  retired
}

/// An SSH CA: an online Ed25519 key in the signer that signs one type of
/// OpenSSH certificate. No chain, no ceremony; rotation is a new generation
/// beside the old.
model SshCa {
  /// `ssh-user-1-g1`.
  id               String             @id
  /// `ncfritz.net SSH User CA 1 - G1`.
  name             String             @unique
  type             SshCertificateType
  number           Int
  generation       Int
  status           SshCaStatus        @default(active)
  keyId            String             @unique @map("key_id") @db.Uuid
  key              Key                @relation(fields: [keyId], references: [id])
  /// Its key, OpenSSH format: what hosts and clients install.
  publicKey        String             @map("public_key")
  /// The longest certificate it signs, in hours.
  maxValidityHours Int                @map("max_validity_hours")
  /// Where its KRL is published.
  krlUrl           String             @map("krl_url")
  retiredAt        DateTime?          @map("retired_at")
  /// The next KRL's version number.
  nextKrlNumber    BigInt             @default(1) @map("next_krl_number")
  /// A new KRL is wanted (a revocation, a new CA): the scheduler writes it.
  krlDueAt         DateTime?          @default(now()) @map("krl_due_at")
  /// When its KRL was last written to the published directory.
  krlPublishedAt   DateTime?          @map("krl_published_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  profileSettings ProfileSshSettings[]
  certificates    SshCertificate[]

  @@unique([type, number, generation])
  @@map("ssh_cas")
}

/// An SSH version's settings (ADR 0035).
model ProfileSshSettings {
  profileVersionId String             @id @map("profile_version_id") @db.Uuid
  profileVersion   ProfileVersion     @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)
  certificateType  SshCertificateType @map("certificate_type")
  /// The CA it is pinned to; unset, the newest active one of its type.
  sshCaId          String?            @map("ssh_ca_id")
  sshCa            SshCa?             @relation(fields: [sshCaId], references: [id])
  validityHours    Int                @map("validity_hours")
  /// Due for renewal this many hours into its life.
  renewAtHours     Int                @map("renew_at_hours")
  /// The force-command critical option: the one command it may run.
  forceCommand     String?            @map("force_command")

  @@map("profile_ssh_settings")
}

/// The source-address critical option: where a user certificate is used from.
model ProfileSshSourceAddress {
  id               Int            @id @default(autoincrement())
  profileVersionId String         @map("profile_version_id") @db.Uuid
  profileVersion   ProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)
  value            String

  @@unique([profileVersionId, value])
  @@map("profile_ssh_source_addresses")
}

/// An OpenSSH extension a version's user certificates carry (permit-pty, …).
model ProfileSshExtension {
  profileVersionId String         @map("profile_version_id") @db.Uuid
  profileVersion   ProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)
  extension        String

  @@id([profileVersionId, extension])
  @@map("profile_ssh_extensions")
}

/// An SSH certificate (ADR 0035): what an SSH CA signed, for which key,
/// and as whom.
model SshCertificate {
  id               String             @id @default(uuid()) @db.Uuid
  sshCaId          String             @map("ssh_ca_id")
  sshCa            SshCa              @relation(fields: [sshCaId], references: [id])
  profileId        String             @map("profile_id")
  profile          Profile            @relation(fields: [profileId], references: [id])
  profileVersionId String             @map("profile_version_id") @db.Uuid
  profileVersion   ProfileVersion     @relation(fields: [profileVersionId], references: [id])
  keyId            String             @map("key_id") @db.Uuid
  key              Key                @relation(fields: [keyId], references: [id])
  type             SshCertificateType
  /// 64 bits, hex.
  serial           String
  /// Its key ID: who it is for and its serial, as sshd logs it.
  keyIdentifier    String             @map("key_identifier")
  /// A user certificate's Olympus identity (email); none for a host's.
  identity         String?
  /// Its key's, `SHA256:…`, as ssh-keygen -l prints it.
  fingerprint      String
  validAfter       DateTime           @map("valid_after")
  validBefore      DateTime           @map("valid_before")
  /// The certificate, OpenSSH format.
  certificate      String
  status           CertificateStatus  @default(valid)
  revokedAt        DateTime?          @map("revoked_at")
  revocationReason RevocationReason?  @map("revocation_reason")
  /// Who issued it: a principal, or the host itself renewing.
  issuedBy         String             @map("issued_by")
  /// The certificate it renews, for a host's renewal.
  renewsId         String?            @unique @map("renews_id") @db.Uuid
  renews           SshCertificate?    @relation("SshRenewal", fields: [renewsId], references: [id])
  renewedBy        SshCertificate?    @relation("SshRenewal")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  principals SshCertificatePrincipal[]
  challenges SshRenewalChallenge[]

  @@unique([sshCaId, serial])
  @@index([identity])
  @@map("ssh_certificates")
}

/// A challenge a host signs with its host key to renew its certificate
/// (ADR 0035): used once, within minutes.
model SshRenewalChallenge {
  id               String         @id @default(uuid()) @db.Uuid
  sshCertificateId String         @map("ssh_certificate_id") @db.Uuid
  sshCertificate   SshCertificate @relation(fields: [sshCertificateId], references: [id], onDelete: Cascade)
  nonce            String         @unique
  expiresAt        DateTime       @map("expires_at")
  usedAt           DateTime?      @map("used_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@map("ssh_renewal_challenges")
}

/// A principal an SSH certificate names, in order.
model SshCertificatePrincipal {
  id               Int            @id @default(autoincrement())
  sshCertificateId String         @map("ssh_certificate_id") @db.Uuid
  sshCertificate   SshCertificate @relation(fields: [sshCertificateId], references: [id], onDelete: Cascade)
  position         Int
  principal        String

  @@unique([sshCertificateId, principal])
  @@map("ssh_certificate_principals")
}

/// The principals (Unix user names) an Olympus identity may log in as with
/// a user certificate: set by an admin (ADR 0035).
model SshPrincipalMapping {
  id        Int      @id @default(autoincrement())
  /// The identity's email, lower case.
  identity  String
  principal String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([identity, principal])
  @@map("ssh_principal_mappings")
}

// ---- Keys, enrollments, certificates

enum KeyPurpose {
  issuer
  subject
  /// An OCSP responder's (ADR 0036): signs one CA's responses.
  ocsp
}

/// Where the private key is.
enum KeyLocation {
  /// In the signer's store: an issuing CA's, or an escrowed subject key.
  signer
  /// Only the subscriber has it (CSR enrollment).
  subscriber
  /// On offline media: a root's or an intermediate's.
  offline
}

/// Every key Harpocrates has seen, once: its SubjectPublicKeyInfo hash is
/// unique across CAs, subjects and SSH (ADR 0020, Keys and enrollment).
model Key {
  id          String      @id @default(uuid()) @db.Uuid
  spkiSha256  String      @unique @map("spki_sha256")
  publicKey   Bytes       @map("public_key")
  algorithm   String
  purpose     KeyPurpose
  location    KeyLocation
  /// The signer's id for it, when the signer holds it.
  signerKeyId String?     @unique @map("signer_key_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  destroyedAt DateTime?   @map("destroyed_at")
  /// Not escrowed: destroyed after its first export.
  exportOnce  Boolean     @default(false) @map("export_once")
  /// Revoked for keyCompromise: never certified again.
  blockedAt   DateTime?   @map("blocked_at")

  issuer          Issuer?
  sshCa           SshCa?
  sshCertificates SshCertificate[]
  ocspResponder   OcspResponder?
  enrollment      Enrollment?
  escrowExports   EscrowExport[]

  @@map("keys")
}

/// csr: the subscriber's key. generated: the signer's (escrowed).
/// imported: a certificate another CA product issued (XCA), with its key
/// wherever it was.
enum EnrollmentMode {
  csr
  generated
  imported
}

/// The request that introduced a key: its CSR, subject, names and profile.
/// The key's certificates (first issue, renewals) are its lineage.
model Enrollment {
  id               String         @id @default(uuid()) @db.Uuid
  keyId            String         @unique @map("key_id") @db.Uuid
  key              Key            @relation(fields: [keyId], references: [id])
  profileId        String         @map("profile_id")
  profile          Profile        @relation(fields: [profileId], references: [id])
  /// The version it issues and renews under (ADR 0034).
  profileVersionId String         @map("profile_version_id") @db.Uuid
  profileVersion   ProfileVersion @relation(fields: [profileVersionId], references: [id])
  mode             EnrollmentMode
  subject          String
  csr              Bytes?
  /// The enrollment a rekey replaced.
  replacesId       String?        @unique @map("replaces_id") @db.Uuid
  replaces         Enrollment?    @relation("EnrollmentReplaces", fields: [replacesId], references: [id])
  replacedBy       Enrollment?    @relation("EnrollmentReplaces")
  createdAt        DateTime       @default(now()) @map("created_at")

  names        EnrollmentName[]
  certificates Certificate[]

  @@map("enrollments")
}

model EnrollmentName {
  id           Int        @id @default(autoincrement())
  enrollmentId String     @map("enrollment_id") @db.Uuid
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  type         NameType
  value        String

  @@unique([enrollmentId, type, value])
  @@map("enrollment_names")
}

enum CertificateStatus {
  valid
  revoked
}

model Certificate {
  id               String            @id @default(uuid()) @db.Uuid
  issuerId         String            @map("issuer_id")
  issuer           Issuer            @relation(fields: [issuerId], references: [id])
  /// Hex, 159 random bits (ADR 0020, Serials).
  serial           String
  enrollmentId     String?           @map("enrollment_id") @db.Uuid
  enrollment       Enrollment?       @relation(fields: [enrollmentId], references: [id])
  profileId        String?           @map("profile_id")
  profile          Profile?          @relation(fields: [profileId], references: [id])
  /// The version it was issued under (ADR 0034).
  profileVersionId String?           @map("profile_version_id") @db.Uuid
  profileVersion   ProfileVersion?   @relation(fields: [profileVersionId], references: [id])
  subject          String
  notBefore        DateTime          @map("not_before")
  notAfter         DateTime          @map("not_after")
  status           CertificateStatus @default(valid)
  der              Bytes
  /// The certificate this one renewed.
  renewsId         String?           @unique @map("renews_id") @db.Uuid
  renews           Certificate?      @relation("CertificateRenews", fields: [renewsId], references: [id])
  renewedBy        Certificate?      @relation("CertificateRenews")
  createdAt        DateTime          @default(now()) @map("created_at")

  revocation    Revocation?
  escrowExports EscrowExport[]
  deployTargets DeployTarget[]
  deployments   Deployment[]
  /// The ACME order it was issued for.
  acmeOrder     AcmeOrder?

  @@unique([issuerId, serial])
  @@index([notAfter])
  @@map("certificates")
}

enum RevocationReason {
  unspecified
  keyCompromise
  cACompromise
  affiliationChanged
  superseded
  cessationOfOperation
  privilegeWithdrawn
}

model Revocation {
  certificateId String           @id @map("certificate_id") @db.Uuid
  certificate   Certificate      @relation(fields: [certificateId], references: [id])
  reason        RevocationReason
  comment       String?
  principal     String
  revokedAt     DateTime         @default(now()) @map("revoked_at")

  @@map("revocations")
}

/// signed: by the signer, for an online CA. ceremony: by an offline CA's
/// key in a ceremony. imported: signed elsewhere (XCA, the offline media)
/// and offered for publication, verified against the CA's certificate.
enum CrlSource {
  signed
  ceremony
  imported
}

/// A revocation list. Only an issuer's newest is published.
model Crl {
  id              Int       @id @default(autoincrement())
  issuerId        String    @map("issuer_id")
  issuer          Issuer    @relation(fields: [issuerId], references: [id])
  number          BigInt
  source          CrlSource @default(signed)
  ceremonyId      String?   @map("ceremony_id")
  ceremony        Ceremony? @relation(fields: [ceremonyId], references: [id])
  thisUpdate      DateTime  @map("this_update")
  nextUpdate      DateTime  @map("next_update")
  /// How many serials it lists.
  entries         Int       @default(0)
  der             Bytes
  createdAt       DateTime  @default(now()) @map("created_at")
  publishedAt     DateTime? @map("published_at")
  publishAttempts Int       @default(0) @map("publish_attempts")
  lastAttemptAt   DateTime? @map("last_attempt_at")
  /// Why the last attempt to publish it failed.
  lastError       String?   @map("last_error")

  @@unique([issuerId, number])
  @@index([issuerId, publishedAt])
  @@map("crls")
}

/// A revocation Harpocrates knows only from a list it imported: a
/// certificate it never issued or imported (XCA's). Every list the issuer
/// signs afterwards carries it.
model ImportedRevocation {
  id        Int              @id @default(autoincrement())
  issuerId  String           @map("issuer_id")
  issuer    Issuer           @relation(fields: [issuerId], references: [id])
  serial    String
  revokedAt DateTime         @map("revoked_at")
  reason    RevocationReason
  /// The list it came from.
  crlNumber BigInt           @map("crl_number")

  @@unique([issuerId, serial])
  @@map("imported_revocations")
}

model EscrowExport {
  id            Int         @id @default(autoincrement())
  keyId         String      @map("key_id") @db.Uuid
  key           Key         @relation(fields: [keyId], references: [id])
  certificateId String      @map("certificate_id") @db.Uuid
  certificate   Certificate @relation(fields: [certificateId], references: [id])
  format        String
  principal     String
  reason        String
  exportedAt    DateTime    @default(now()) @map("exported_at")

  @@map("escrow_exports")
}

// ---- Deploy targets

/// Where a deploy target puts a certificate (ADR 0020, Renewal and
/// delivery). host_path: files in a directory a web server reads, which
/// reloads when they change. DSM and the printer come later.
enum DeployKind {
  host_path
}

/// A place a certificate is installed for something that can neither
/// renew over mutual TLS nor speak ACME. Its certificate's key is
/// generated and escrowed; Harpocrates renews the certificate when due,
/// the target follows the renewal, and every new certificate is deployed.
model DeployTarget {
  id            String      @id @default(uuid()) @db.Uuid
  /// Also its directory, under DEPLOY_DIR.
  name          String      @unique
  kind          DeployKind  @default(host_path)
  /// What it deploys: the newest of its lineage.
  certificateId String      @map("certificate_id") @db.Uuid
  certificate   Certificate @relation(fields: [certificateId], references: [id])
  /// host:port, where it is served and checked: its name on 443 by default.
  endpoint      String
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  deployments  Deployment[]
  observations EndpointObservation[]

  @@map("deploy_targets")
}

/// pending: to do, or failing and retried (with lastError). superseded:
/// a newer deployment to the same target replaced it before it succeeded.
enum DeploymentStatus {
  pending
  deployed
  superseded
}

/// One certificate, installed at one target.
model Deployment {
  id            String           @id @default(uuid()) @db.Uuid
  targetId      String           @map("target_id") @db.Uuid
  target        DeployTarget     @relation(fields: [targetId], references: [id], onDelete: Cascade)
  certificateId String           @map("certificate_id") @db.Uuid
  certificate   Certificate      @relation(fields: [certificateId], references: [id])
  status        DeploymentStatus @default(pending)
  /// Who asked: a principal, or `system` for a renewal it followed.
  principal     String
  attempts      Int              @default(0)
  lastAttemptAt DateTime?        @map("last_attempt_at")
  /// Why the last attempt failed.
  lastError     String?          @map("last_error")
  deployedAt    DateTime?        @map("deployed_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([targetId, createdAt])
  @@index([status])
  @@map("deployments")
}

/// What an endpoint served when it was checked. current: the target's
/// certificate. previous: one it deployed before (not reloaded yet).
/// other: a certificate it never deployed. unreachable: no TLS handshake.
enum EndpointResult {
  current
  previous
  other
  unreachable
}

/// What a deploy target's endpoint served (ADR 0020, Renewal and
/// delivery): one row while the answer stays the same, from when it was
/// first seen (createdAt) to when it was last seen (updatedAt).
model EndpointObservation {
  id                    String         @id @default(uuid()) @db.Uuid
  targetId              String         @map("target_id") @db.Uuid
  target                DeployTarget   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  /// The host:port checked.
  endpoint              String
  result                EndpointResult
  /// The target's certificate when it was checked.
  expectedCertificateId String         @map("expected_certificate_id") @db.Uuid
  /// The certificate served, when it is one this target deployed.
  servedCertificateId   String?        @map("served_certificate_id") @db.Uuid
  servedSha256          String?        @map("served_sha256")
  servedSerial          String?        @map("served_serial")
  servedSubject         String?        @map("served_subject")
  servedNotAfter        DateTime?      @map("served_not_after")
  /// Whether the served certificate requires a stapled OCSP response.
  servedMustStaple      Boolean?       @map("served_must_staple")
  /// Whether the endpoint stapled an OCSP response.
  stapled               Boolean?
  /// Why there was no handshake.
  error                 String?
  /// How many checks saw this.
  checks                Int            @default(1)
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  @@index([targetId, updatedAt])
  @@map("endpoint_observations")
}

// ---- ACME (ADR 0020, ACME): RFC 8555 on the renewal listener, for the
// TLS CA, with External Account Binding required.

/// An External Account Binding credential, made in the console: what lets
/// an ACME client register, and which names its account may request.
/// Single use: binding it to an account erases its key.
model AcmeEabCredential {
  /// The EAB key id an ACME client is given (`--eab-kid`).
  id        String    @id
  /// What it is for: the host or the client that holds it.
  label     String
  /// The HMAC key, base64url, until an account binds it.
  hmacKey   String?   @map("hmac_key")
  /// Who made it.
  principal String
  boundAt   DateTime? @map("bound_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  names   AcmeNamePolicy[]
  account AcmeAccount?

  @@map("acme_eab_credentials")
}

/// exact: that DNS name only. subtree: the name and every name below it.
enum AcmeNameKind {
  exact
  subtree
}

/// A name, or a subtree of names, a credential's account may request.
model AcmeNamePolicy {
  id           Int               @id @default(autoincrement())
  credentialId String            @map("credential_id")
  credential   AcmeEabCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  kind         AcmeNameKind
  /// A DNS name, lower case, without a trailing dot.
  value        String
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@unique([credentialId, kind, value])
  @@map("acme_name_policies")
}

enum AcmeAccountStatus {
  valid
  deactivated
  revoked
}

/// An ACME account: its key, and the credential it was bound with.
model AcmeAccount {
  id            String            @id @default(uuid()) @db.Uuid
  credentialId  String            @unique @map("credential_id")
  credential    AcmeEabCredential @relation(fields: [credentialId], references: [id])
  /// RFC 7638 SHA-256 thumbprint of its key, base64url: one account a key.
  keyThumbprint String            @unique @map("key_thumbprint")
  /// Its key, SubjectPublicKeyInfo DER.
  publicKey     Bytes             @map("public_key")
  status        AcmeAccountStatus @default(valid)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  contacts AcmeAccountContact[]
  orders   AcmeOrder[]

  @@map("acme_accounts")
}

/// A contact URI an account gave (mailto:).
model AcmeAccountContact {
  id        Int         @id @default(autoincrement())
  accountId String      @map("account_id") @db.Uuid
  account   AcmeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  uri       String
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@unique([accountId, uri])
  @@map("acme_account_contacts")
}

/// RFC 8555 §7.1.6: pending (authorizations to do), ready (to finalize),
/// processing (being issued), valid (issued), invalid (failed or expired).
enum AcmeOrderStatus {
  pending
  ready
  processing
  valid
  invalid
}

/// A request for a certificate for some DNS names (RFC 8555 §7.4).
model AcmeOrder {
  id            String          @id @default(uuid()) @db.Uuid
  accountId     String          @map("account_id") @db.Uuid
  account       AcmeAccount     @relation(fields: [accountId], references: [id])
  status        AcmeOrderStatus @default(pending)
  expiresAt     DateTime        @map("expires_at")
  /// What finalizing it issued.
  certificateId String?         @unique @map("certificate_id") @db.Uuid
  certificate   Certificate?    @relation(fields: [certificateId], references: [id])
  /// Why it is invalid: an ACME error type and its detail.
  errorType     String?         @map("error_type")
  errorDetail   String?         @map("error_detail")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  authorizations AcmeAuthorization[]

  @@index([accountId, createdAt])
  @@map("acme_orders")
}

/// RFC 8555 §7.1.4.
enum AcmeAuthorizationStatus {
  pending
  valid
  invalid
  deactivated
  expired
  revoked
}

/// Proof the account controls one DNS name, for one order.
model AcmeAuthorization {
  id         String                  @id @default(uuid()) @db.Uuid
  orderId    String                  @map("order_id") @db.Uuid
  order      AcmeOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// The DNS name, lower case.
  identifier String
  status     AcmeAuthorizationStatus @default(pending)
  expiresAt  DateTime                @map("expires_at")
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")

  challenges AcmeChallenge[]

  @@unique([orderId, identifier])
  @@map("acme_authorizations")
}

/// http-01 (RFC 8555 §8.3) and tls-alpn-01 (RFC 8737). dns-01 is not
/// offered (ADR 0020, ACME).
enum AcmeChallengeType {
  http_01     @map("http-01")
  tls_alpn_01 @map("tls-alpn-01")
}

enum AcmeChallengeStatus {
  pending
  processing
  valid
  invalid
}

model AcmeChallenge {
  id              String              @id @default(uuid()) @db.Uuid
  authorizationId String              @map("authorization_id") @db.Uuid
  authorization   AcmeAuthorization   @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  type            AcmeChallengeType
  /// Random, base64url: what the client serves, with its key's thumbprint.
  token           String              @unique
  status          AcmeChallengeStatus @default(pending)
  validatedAt     DateTime?           @map("validated_at")
  errorType       String?             @map("error_type")
  errorDetail     String?             @map("error_detail")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@unique([authorizationId, type])
  @@map("acme_challenges")
}

/// A Replay-Nonce handed out and not yet used: each is good once, briefly.
model AcmeNonce {
  value     String   @id
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("acme_nonces")
}

// ---- Audit

/// Append-only and hash-chained: each event's hash covers the previous
/// event's hash and its own fields and attributes.
model AuditEvent {
  sequence     BigInt   @id @default(autoincrement())
  occurredAt   DateTime @default(now()) @map("occurred_at")
  kind         String
  principal    String
  /// Where it came from: api, cli, acme, renewal, system.
  surface      String
  subjectType  String?  @map("subject_type")
  subjectId    String?  @map("subject_id")
  reason       String?
  previousHash String   @map("previous_hash")
  hash         String   @unique

  attributes AuditEventAttribute[]

  @@index([occurredAt])
  @@index([subjectType, subjectId])
  @@map("audit_events")
}

model AuditEventAttribute {
  sequence BigInt     @map("event_sequence")
  event    AuditEvent @relation(fields: [sequence], references: [sequence], onDelete: Restrict)
  name     String
  value    String

  @@id([sequence, name])
  @@map("audit_event_attributes")
}

// ---- OCSP (ADR 0036)

/// active: signs its CA's responses. superseded: replaced by a newer one;
/// its responses are re-signed by that one, and its key destroyed once it
/// expires.
enum OcspResponderStatus {
  active
  superseded
}

/// The hash a request's CertID uses.
enum OcspCertIdHash {
  sha1
  sha256
}

enum OcspCertStatus {
  good
  revoked
}

/// A CA's OCSP responder: a certificate the CA issued for an `ocsp` key
/// in the signer (OCSPSigning, ocsp-nocheck). An online CA's is issued and
/// renewed by the service; an offline CA's in a ceremony.
model OcspResponder {
  id          String              @id @default(uuid()) @db.Uuid
  issuerId    String              @map("issuer_id")
  issuer      Issuer              @relation(fields: [issuerId], references: [id])
  keyId       String              @unique @map("key_id") @db.Uuid
  key         Key                 @relation(fields: [keyId], references: [id])
  serial      String
  subject     String
  certificate Bytes
  notBefore   DateTime            @map("not_before")
  notAfter    DateTime            @map("not_after")
  status      OcspResponderStatus @default(active)
  /// The ceremony it was issued in: an offline CA's.
  ceremonyId  String?             @map("ceremony_id")
  ceremony    Ceremony?           @relation(fields: [ceremonyId], references: [id])
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  responses OcspResponse[]

  @@unique([issuerId, serial])
  @@index([issuerId, status])
  @@map("ocsp_responders")
}

/// A signed response for one certificate of a CA, by CertID hash: kept and
/// served until its nextUpdate, re-signed daily and on a change of status.
model OcspResponse {
  id          String            @id @default(uuid()) @db.Uuid
  issuerId    String            @map("issuer_id")
  issuer      Issuer            @relation(fields: [issuerId], references: [id])
  /// Hex, as the certificate's.
  serial      String
  hash        OcspCertIdHash
  status      OcspCertStatus
  revokedAt   DateTime?         @map("revoked_at")
  reason      RevocationReason?
  responderId String            @map("responder_id") @db.Uuid
  responder   OcspResponder     @relation(fields: [responderId], references: [id])
  der         Bytes
  thisUpdate  DateTime          @map("this_update")
  nextUpdate  DateTime          @map("next_update")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@unique([issuerId, serial, hash])
  @@index([nextUpdate])
  @@map("ocsp_responses")
}

/// The Olympus users Harpocrates has seen (ADR 0020, Audit): an access
/// token names a user by their ID alone, so the audit log and everything
/// else records `user:<id>`; this says who that is. Written when the
/// console asks who is signed in (the Olympus API describes them).
model OlympusUser {
  /// The user's ID, the access token's `sub`.
  id        String   @id
  /// Their email, as the Olympus API last described them.
  email     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("olympus_users")
}
