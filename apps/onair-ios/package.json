{
  "name": "@ncfritz/olympus-onair-ios",
  "description": "OnAir for iPhone: Minerva availability, overrides and meeting status (docs/plans/onair-ios)",
  "version": "0.0.0",
  "private": true,
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "main": "expo-router/entry",
  "scripts": {
    "ios": "expo run:ios",
