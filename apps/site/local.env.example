# Copy to local.env (git-ignored) and fill in. `pnpm dev:local` reads
# local.env; `pnpm dev` reads dev.env (dev.env.example).
#
# local.env runs the site against a stack on this machine: the API from
# `pnpm dev` in apps/api, which serves /v1 itself -- the /api in front of the
# dev host is nginx's (ADR 0019).
# Everything NEXT_PUBLIC_ is compiled into the browser bundle, so nothing
# secret belongs in one.

# Which environment the site says it is. `dev` when unset.
NEXT_PUBLIC_ENVIRONMENT=local

# The API's front door, with no /api and no version: the site adds those.
NEXT_PUBLIC_OLYMPUS_HOST=http://localhost:3001

# Where content and media are served from.
NEXT_PUBLIC_CONTENT_CDN_HOST=https://content-cdn.dev.ncfritz.net:9443
NEXT_PUBLIC_DIONYSUS_CDN_HOST=https://dionysus-cdn.dev.ncfritz.net
NEXT_PUBLIC_ONAIR_API_HOST=https://onair.sea.ncfritz.net

# There is nothing secret left to put here. The site is a public client
# (ADR 0018): the authorization code flow with PKCE, no client secret, and a
# refresh token the API keeps in an httpOnly cookie that no script can read.
# Everything above is compiled into the browser bundle, which is why that
# matters.
#
# NEXTAUTH_SECRET and GITHUB_CLIENT_SECRET used to live here. They are the pair
# that was committed to the site's history, and docs/roadmap.md lists them for
# rotation -- removing them from this file does not retire them.
