{
  "name": "@ncfritz/olympus-site",
  "description": "Olympus: the site people use, imported for authentication only (authentication plan phase 5)",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf .next",
    "dev": "env-cmd -f dev.env next dev",
    "dev:local": "env-cmd -f local.env next dev",
    "build": "env-cmd --silent --no-override -f dev.env next build",
    "start": "next start",
    "start:local": "env-cmd -f local.env next start",
    "lint": "eslint ./src",
    "lintfix": "eslint ./src --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "analyze:client": "RSDOCTOR=true rsdoctor analyze --profile .next/.rsdoctor/manifest.json",
    "analyze:server": "RSDOCTOR=true rsdoctor analyze --profile .next/server/.rsdoctor/manifest.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@deck.gl/react": "^9.3.2",
    "@eslint/js": "^9.29.0",
    "@rsdoctor/webpack-plugin": "^1.5.12",
    "@svgr/webpack": "^8.1.0",
    "@types/google.maps": "^3.66.4",
    "@types/luxon": "^3.4.2",
    "@types/node": "22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/react-html-parser": "^2.0.6",
    "@types/react-otp-input": "^2.0.5",
    "@types/react-redux": "^7.1.34",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/styled-components": "^5.1.34",
    "@vitest/coverage-v8": "catalog:",
    "copy-webpack-plugin": "^12.0.2",
    "core-js": "^3.36.1",
    "env-cmd": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.2.0",
    "plyr": "^3.8.3",
    "prettier": "^3.2.5",
    "tinymce": "8.8.2",
    "tinymce-premium": "^8.8.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.34.1",
    "vitest": "catalog:"
  },
