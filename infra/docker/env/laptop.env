# The dev laptop: a full local stack for working away from the home lab
# (ADR 0019). The same compose files as the Mac Mini; images are built
# here (`docker buildx bake --load`) and never pushed. No secrets.

OLYMPUS_HOST=laptop
DATA_DIR=/Users/ncfritz/Docker/olympus/data
SECRETS_DIR=/Users/ncfritz/Docker/olympus/secrets

IMAGE_PREFIX=olympus
OLYMPUS_TAG=dev
HASURA_TAG=dev
RABBITMQ_TAG=dev
# The same major as production's, so its backups restore here.
POSTGRES_VERSION=
NGINX_VERSION=

# The console for inspecting data and trying queries.
HASURA_CONSOLE=true

# The stacks, in start order; add nginx to try the proxy locally.
STACKS="data rabbitmq olympus"

# `minerva` when wanted; the site isn't available here until it's imported.
COMPOSE_PROFILES=

LAN_BIND=127.0.0.1
# Created by `stack.sh bootstrap` when there is no monitoring stack.
MONITORING_NETWORK=olympus-monitoring
LOKI_URL=
MINERVA_HOST=minerva.localhost

ASSET_AGENT_CPUS=2
ASSET_AGENT_MEMORY=3g
