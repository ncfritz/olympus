# local: a development environment on the laptop, from the same compose
# files as prod (ADR 0019). Images are built here
# (`docker buildx bake --load`) and never pushed.

OLYMPUS_ENV=local
DATA_DIR=/Users/ncfritz/Docker/olympus/data

OLYMPUS_TAG=dev
SECRETS_DIR=/Users/ncfritz/Docker/olympus/secrets

IMAGE_PREFIX=olympus

HASURA_TAG=dev
RABBITMQ_TAG=dev
# The same major as production's, so its backups restore here.
POSTGRES_VERSION=16.3
NGINX_VERSION=1.29.3

# The console for inspecting data and trying queries.
HASURA_CONSOLE=true

# The stacks, in start order; add nginx to try the proxy locally. Drop
# `data` and `rabbitmq` to run lean against prod's dev resources instead
# (below).
STACKS="data rabbitmq olympus"

# `minerva` when wanted; the site isn't available here until it's imported.
COMPOSE_PROFILES=

LAN_BIND=127.0.0.1
# Created by `stack.sh bootstrap` when there is no monitoring stack.
MONITORING_NETWORK=olympus-monitoring
LOKI_URL=
CONTROL_HOST=control.olympus.localhost
CONTROL_CONSOLES=minerva/calendar

# ---- Development resources. Local is a development environment wherever
# its data lives: every service connects as the one dev user, on the dev
# vhost, whether the broker is its own or prod's. Only where they live
# changes, and only these three lines change with it.
AMQP_VHOST=/dionysus-dev
AMQP_USER_OVERRIDE=olympus-dev

# Against prod's dev resources rather than its own stacks:
# HASURA_HOST=olympus.dev.ncfritz.net
# HASURA_PORT=8081
# AMQP_HOST=olympus.dev.ncfritz.net

ASSET_AGENT_CPUS=2
ASSET_AGENT_MEMORY=3g
