# Settings of this service on this host that are not secret and not wiring
# (hosts, ports and secret paths are in infra/docker/compose/olympus.yml).

ENABLE_API_EXPLORER=true
LOKI_LEVEL=debug
CONSOLE_LOGGING_LEVEL=debug

# Authentication (ADR 0018): report until enforcement (auth phase 8).
AUTH_MODE_USERS=report
AUTH_MODE_SERVICES=report
# The mTLS listener starts once these are set; the files go in
# ${SECRETS_DIR}/tls/olympus-api (see docs/guides/certificates.md).
# TLS_CERT=/run/secrets/tls/api.crt
# TLS_KEY=/run/secrets/tls/api.key
# TLS_CA_SERVICES=/run/secrets/tls/services-ca.crt
# TLS_CRL_SERVICES=/run/secrets/tls/services.crl,/run/secrets/tls/root.crl
# AUTH_SERVICE_ROLES=dionysus-asset-agent:agent,dionysus-metadata-agent:agent,dionysus-search-agent:agent,olympus-notification-agent:agent
