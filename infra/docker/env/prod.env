# prod: the platform as it runs, on the Mac Mini, and the dev Hasura and
# dev vhost that local and the workspace point at (ADR 0019). Compose
# reads this for every stack (infra/docker/stack.sh passes it). No
# secrets: those are files in SECRETS_DIR.

OLYMPUS_ENV=prod
OLYMPUS_TAG=3ab21dd

DATA_DIR=/Users/ncfritz/Docker/data
SECRETS_DIR=/Users/ncfritz/Docker/secrets

# ---- Images. OLYMPUS_TAG is the commit a deploy runs; a rollback sets it back.
IMAGE_PREFIX=registry.internal.ncfritz.net/olympus

# The schema goes to hasura-dev first, then here.
HASURA_TAG=
HASURA_DEV_TAG=
RABBITMQ_TAG=

# Pinned in Docker plan phase 0: Postgres at its data directory's major.
POSTGRES_VERSION=16.3
NGINX_VERSION=1.29.3

# The site's pre-monorepo image, pinned, until the site is imported.
SITE_IMAGE=ncfritz/olympus-site:latest

# ---- What runs: the stacks, in start order, and the profiles.
STACKS="data hasura-dev rabbitmq olympus nginx"
COMPOSE_PROFILES=site,minerva

# ---- Network. LAN_BIND publishes AMQP, the API's 3443 and hasura-dev to
# the LAN; the admin ports stay on 127.0.0.1 whatever this says.
LAN_BIND=0.0.0.0
MONITORING_NETWORK=grafana_grafana_net
LOKI_URL=http://loki-server:3100

# ---- Olympus Control: the console suite on one host (ADR 0021), and
# which of its consoles this host runs. One canonical name, whichever side
# of the split horizon you are on: sessions and OIDC redirect URIs belong
# to a host, so the internal name redirects here rather than serving.
CONTROL_HOST=control.olympus.ncfritz.net
CONTROL_CONSOLES=minerva/calendar

# ---- Limits for the transcoding asset agent; tune to Docker's VM.
ASSET_AGENT_CPUS=4
ASSET_AGENT_MEMORY=6g
