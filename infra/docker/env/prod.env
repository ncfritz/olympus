# prod: the platform as it runs, on the Mac Mini, and the dev Hasura and
# dev vhost that local and the workspace point at (ADR 0019). Compose
# reads this for every stack (infra/docker/stack.sh passes it). No
# secrets: those are files in SECRETS_DIR.

OLYMPUS_ENV=prod
OLYMPUS_TAG=fbd30f85

DATA_DIR=/Users/ncfritz/Docker/data
# Where the nightly olympus_backup DAG writes (infra/airflow), one folder a
# day; `stack.sh refresh-dev` restores from here.
BACKUP_DIR=/Users/ncfritz/Docker/data/olympus/backups
SECRETS_DIR=/Users/ncfritz/Docker/secrets/olympus
# What `stack.sh check` expects of the certificates under SECRETS_DIR/tls:
# the CAs that issue server certificates (server.crt) and service
# certificates (client.crt), and the OU every client certificate on this
# host carries (the NAS's say nas).
TLS_SERVER_ISSUER="ncfritz.net Issuing CA 2 - G1"
TLS_SERVICES_ISSUER="ncfritz.net Service Issuing CA 1 - G1"
TLS_CLIENT_OU=prod

# ---- Images. OLYMPUS_TAG is the commit a deploy runs; a rollback sets it back.
IMAGE_PREFIX=registry.internal.ncfritz.net/olympus

# The schema goes to hasura-dev first, then here.
HASURA_TAG=248976e9
HASURA_DEV_TAG=248976e9
RABBITMQ_TAG=248976e9

# Pinned in Docker plan phase 0: Postgres at its data directory's major.
POSTGRES_VERSION=16.3

# The nightly backup DAG's HTTP client, for RabbitMQ's definitions
# (infra/airflow). The postgres image it runs everything else in has none.
BACKUP_HTTP_IMAGE=curlimages/curl:8.11.1
NGINX_VERSION=1.29.3
# Harpocrates's own Postgres (compose/harpocrates.yml), pinned the same way.
HARPOCRATES_POSTGRES_VERSION=16.3
# The registry's web UI (ghcr.io/eznix86/docker-registry-ui). Check the tag
# against its releases; 1.4.0 was current when this was wired up.
REGISTRY_UI_VERSION=
# Who may sign in to it. Not optional: with no allowlist the UI admits any
# account Google authenticates, which is everyone.
REGISTRY_UI_ALLOWED_EMAILS=

# The site's pre-monorepo image, pinned, until the site is imported.
# ---- The site. Compiled into its bundle at build time, not read at runtime
# (apps/site/src/utils/constants.ts), so these are settings of the image and
# `stack.sh build site` is where they are read. The three that say where data
# comes from are required by the app: empty here fails the build, which is the
# point -- the fallbacks they replaced were the development hosts, and a
# forgotten argument used to produce a working site quietly pointed at dev.
NEXT_PUBLIC_ENVIRONMENT=prod
# The site's own public address, for the links and QR codes it shows people.
# With the scheme: these are concatenated with paths, not parsed as hostnames.
NEXT_PUBLIC_OLYMPUS_HOST=https://olympus.ncfritz.net
# Where media and metadata are fetched from.
NEXT_PUBLIC_CONTENT_CDN_HOST=https://content-cdn.sea.ncfritz.net:9443
NEXT_PUBLIC_DIONYSUS_CDN_HOST=https://dionysus-cdn.sea.ncfritz.net:9443
# The Maps key is compiled in too, but it reaches the build as a buildx secret
# rather than an argument, because arguments are visible in `docker history`.
# The file is SECRETS_DIR/<this name>.
MAPS_KEY_SECRET=google_maps_api_key

# ---- What runs: the stacks, in start order, and the profiles.
# harpocrates before olympus and nginx, which read what it publishes.
STACKS="data hasura-dev rabbitmq harpocrates olympus nginx"
COMPOSE_PROFILES=minerva

# ---- The NAS (compose/nas.yml), which is part of this environment but a
# different machine: Compose resolves these on the Docker host, so they are
# NAS paths. Deliberately absent from STACKS — it is driven explicitly with
# DOCKER_CONTEXT=nas.
NAS_DATA_DIR=/volume4/Dionysus
NAS_SECRETS_DIR=/volume4/olympus/secrets
# `id dionysus` on the NAS: the account that owns the media, which the
# agent has to run as to get past the shared folder's ACLs. Its secrets
# are owned by this uid too.
NAS_AGENT_USER=1028:100

# ---- The border (compose/border.yml), also on the NAS and also absent from
# STACKS. Paths on that machine, for the same reason.
# The configuration from infra/docker/nginx-border/, copied there; see the
# compose file's header for why it is a copy and not this checkout.
NAS_BORDER_CONFIG_DIR=/volume4/olympus/border/nginx
# certs/ (the Olympus Devices chain and its revocation list, and the internal
# CA), letsencrypt/, acme/ and logs/.
NAS_BORDER_DIR=/volume4/olympus/border

# What a service on another machine reaches this host by. Inside this host
# the container names do; over the LAN they do not resolve.
PROD_LAN_HOST=snowball.desktop.ncfritz.net
# The mTLS listener (ADR 0018), not nginx: a service off this host
# authenticates with a certificate, and nginx would terminate the TLS that
# carries it.
API_LAN_URL=https://api.olympus.internal.ncfritz.net:3443/v1

# ---- Network. LAN_BIND publishes AMQP, the API's 3443 and hasura-dev to
# the LAN; the admin ports stay on 127.0.0.1 whatever this says.
LAN_BIND=0.0.0.0
MONITORING_NETWORK=grafana_grafana_net
LOKI_URL=http://loki-server:3100

# ---- Olympus Control: the console suite on one host (ADR 0021), and
# which of its consoles this host runs. One canonical name, whichever side
# of the split horizon you are on: sessions and OIDC redirect URIs belong
# to a host, so the internal name redirects here rather than serving.
CONTROL_HOST=control.olympus.ncfritz.net
CONTROL_CONSOLES=minerva/calendar

# ---- Limits for the transcoding asset agent; tune to Docker's VM.
ASSET_AGENT_CPUS=4
ASSET_AGENT_MEMORY=6g

# ---- Weather (ADR 0024): where the stations' archive is copied nightly
# (infra/airflow/dags/olympus_weather_archive.py), over SFTP like the host's
# other DAGs: the Airflow connection (nfs01.sea.ncfritz.net, user `weather`,
# its password in the connection, not here) and the folder that user sees,
# the `Weather` share.
WEATHER_NAS_SFTP_CONNECTION=olympus_weather_sftp
WEATHER_NAS_SFTP_DIR=/Weather
