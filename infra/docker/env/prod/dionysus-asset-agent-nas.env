# The asset agent as it runs on the NAS (compose/nas.yml). Settings that
# are not secret and not wiring; hosts, ports and secret paths are in the
# compose file.
#
# The NAS is where the media is, so this deployment does the work that
# needs the files themselves and prod's deployment does raw ingestion.
# Everything under /data is the one bind mount, ${NAS_DATA_DIR}.

LOKI_LEVEL=debug
CONSOLE_LOGGING_LEVEL=debug

# File logging is turned on in compose/nas.yml, with its path.
FILE_LOGGING_LEVEL=debug

# Handlers are on unless disabled. Raw ingestion runs on prod; the
# transcode handler itself is off here, so a transcode is configured and
# verified but not run.
DISABLE_CONTENT_RAW_INGESTION_HANDLER=true
DISABLE_DIONYSUS_XCODE_HANDLER=true
DISABLE_CONTENT_DELETION_HANDLER=false
DISABLE_CONTENT_HLS_HANDLER=false
DISABLE_CONTENT_THUMBNAIL_HANDLER=false
DISABLE_DIONYSUS_METADATA_HANDLER=false
DISABLE_DIONYSUS_XCODE_PRE_CONFIGURATION_HANDLER=false
DISABLE_DIONYSUS_XCODE_CONFIGURATION_HANDLER=false
DISABLE_DIONYSUS_VERIFY_XCODE_HANDLER=false
DISABLE_DIONYSUS_CLEANUP_HANDLER=false
DISABLE_DIONYSUS_DELETE_MEDIA_WORKFLOW_HANDLER=false
DISABLE_DIONYSUS_START_DOWNLOAD_HANDLER=false
DISABLE_DIONYSUS_DOWNLOAD_UPDATE_HANDLER=false
DISABLE_DIONYSUS_DOWNLOAD_STATUS_HANDLER=false

# NordVPN SOCKS proxy (the credentials are secrets).
SOCKS_PROXY_HOST=los-angeles.us.socks.nordhold.net
SOCKS_PROXY_PORT=1080

# The image's tools (apk's ffmpeg and handbrake).
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
HANDBRAKE_PATH=/usr/bin/HandBrakeCLI

LOCAL_DIRECTORY=/data/workflow
STAGING_DIRECTORY=/data/workflow
DIONYSUS_CDN_BASE_URL=https://dionysus-cdn.sea.ncfritz.net
# local: the media is on this machine, so a transcode does not pull it
# over SSH. This is the reason the agent runs here at all.
DEPLOYMENT_MODE=local
CONTENT_ASSETS_DIR=/data/content/assets
CONTENT_ASSETS_DOWNLOAD_DIR=/data/content/downloads
CONTENT_ASSETS_TEMP_DIR=/data/content/temp

# The library is on nfs02, so that one is still remote.
CONTENT_SSH_HOST=nfs01.sea.ncfritz.net
CONTENT_SSH_USERNAME=content
DIONYSUS_SKIP_SSH_UPLOAD=false
DIONYSUS_SKIP_CDN_DOWNLOAD=false
DIONYSUS_LIBRARY_SSH_HOST=nfs02.sea.ncfritz.net
DIONYSUS_LIBRARY_SSH_USERNAME=dionysus
DIONYSUS_CDN_SSH_HOST=nfs01.sea.ncfritz.net
DIONYSUS_CDN_SSH_USERNAME=dionysus

NZBGET_HOST=nfs01.sea.ncfritz.net
NZBGET_PORT=6789
NZBGET_USERNAME=dionysus
