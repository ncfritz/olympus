# Settings of this service on this host that are not secret and not wiring
# (hosts, ports and secret paths are in infra/docker/compose/olympus.yml).

LOKI_LEVEL=debug
CONSOLE_LOGGING_LEVEL=debug

# Handlers are on unless disabled. This deployment runs raw ingestion only;
# the NAS runs the rest (compose/nas.yml, phase 5).
DISABLE_CONTENT_DELETION_HANDLER=true
DISABLE_CONTENT_HLS_HANDLER=true
DISABLE_CONTENT_THUMBNAIL_HANDLER=true
DISABLE_CONTENT_RAW_INGESTION_HANDLER=false
DISABLE_DIONYSUS_METADATA_HANDLER=true
DISABLE_DIONYSUS_XCODE_PRE_CONFIGURATION_HANDLER=true
DISABLE_DIONYSUS_XCODE_CONFIGURATION_HANDLER=true
DISABLE_DIONYSUS_XCODE_HANDLER=true
DISABLE_DIONYSUS_VERIFY_XCODE_HANDLER=true
DISABLE_DIONYSUS_CLEANUP_HANDLER=true
DISABLE_DIONYSUS_DELETE_MEDIA_WORKFLOW_HANDLER=true
DISABLE_DIONYSUS_START_DOWNLOAD_HANDLER=true
DISABLE_DIONYSUS_DOWNLOAD_UPDATE_HANDLER=true
DISABLE_DIONYSUS_DOWNLOAD_STATUS_HANDLER=true

# NordVPN SOCKS proxy (the credentials are secrets).
SOCKS_PROXY_HOST=los-angeles.us.socks.nordhold.net
SOCKS_PROXY_PORT=1080

# The image's tools (apk's ffmpeg and handbrake).
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
HANDBRAKE_PATH=/usr/bin/HandBrakeCLI

LOCAL_DIRECTORY=/dionysus/media/local
STAGING_DIRECTORY=/dionysus/media/staging
DIONYSUS_CDN_BASE_URL=https://dionysus-cdn.dev.ncfritz.net
# docker: pulling an asset for transcoding goes over SSH.
DEPLOYMENT_MODE=docker
CONTENT_ASSETS_DIR=/dionysus/content/assets
CONTENT_ASSETS_DOWNLOAD_DIR=/dionysus/content/downloads
CONTENT_ASSETS_TEMP_DIR=/dionysus/content/temp

CONTENT_SSH_HOST=nfs01.sea.ncfritz.net
CONTENT_SSH_USERNAME=content
DIONYSUS_SKIP_SSH_UPLOAD=false
DIONYSUS_SKIP_CDN_DOWNLOAD=false
DIONYSUS_LIBRARY_SSH_HOST=nfs02.sea.ncfritz.net
DIONYSUS_LIBRARY_SSH_USERNAME=dionysus
DIONYSUS_CDN_SSH_HOST=nfs01.sea.ncfritz.net
DIONYSUS_CDN_SSH_USERNAME=dionysus

NZBGET_HOST=nfs01.sea.ncfritz.net
NZBGET_PORT=6789
NZBGET_USERNAME=dionysus
