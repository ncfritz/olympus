# Settings of Harpocrates's service on this host that are not secret and
# not wiring (hosts, ports and secret paths are in
# infra/docker/compose/harpocrates.yml). Every variable is in
# apps/harpocrates/service/README.md.

# The API document at /api-spec, as the API serves its own.
ENABLE_API_EXPLORER=true
CONSOLE_LOGGING_LEVEL=info
LOKI_LEVEL=info

# CA names and what is published where (ADR 0020, Naming, Distribution).
PKI_REALM=ncfritz.net
PKI_ORGANIZATION=ncfritz.net
PKI_DISTRIBUTION_URL=http://pki.internal.ncfritz.net

# Ceremonies and escrow export want a sign-in this recent, in seconds.
AUTH_RECENT_SIGN_IN_SECONDS=300

# The lists (defaults: 7 days, re-signed daily; 13 months offline).
# CRL_VALIDITY_HOURS=168
# CRL_REFRESH_HOURS=24
# CRL_OFFLINE_VALIDITY_DAYS=395
