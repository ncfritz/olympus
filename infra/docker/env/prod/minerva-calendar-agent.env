# Settings of this service on this host that are not secret and not wiring
# (hosts, ports and secret paths are in infra/docker/compose/olympus.yml).
# Minerva is behind the `minerva` profile until these are filled in.

LOKI_LEVEL=debug
CONSOLE_LOGGING_LEVEL=info

GOOGLE_OAUTH_CLIENT_ID=728437817202-o5loefc5st3n88e7lggjia4aekmei3hg.apps.googleusercontent.com
MICROSOFT_OAUTH_CLIENT_ID=74ee7649-b2c1-4089-bb0e-f9cbdfe9f6f3
MICROSOFT_OAUTH_TENANT_ID=common

# Accounts connected from the Olympus site sign in through web clients
# (ADR 0028, calendar users phase 4): the Google "Web application" client's
# ID here, its secret and the Microsoft web platform's secret as secrets
# (GOOGLE_WEB_OAUTH_CLIENT_SECRET_FILE, MICROSOFT_OAUTH_CLIENT_SECRET_FILE).
GOOGLE_WEB_OAUTH_CLIENT_ID=728437817202-4v4blnqs8i7ue129opmlfr1ivqjgclqd.apps.googleusercontent.com

POLL_INTERVAL_MS=45000
SYNC_WINDOW_PAST_DAYS=30
SYNC_WINDOW_FUTURE_DAYS=180
SYNC_HISTORY_RETENTION_DAYS=90
# Push notifications need a public HTTPS name at the border (auth phase 6);
# until then the agent polls.
WEBHOOK_BASE_URL=

# Publishing to Olympus over RabbitMQ (roadmap 8b).
OUTBOX_ENABLED=true

# The services listener for the Olympus API (ADR 0028, calendar users phase
# 3). ${SECRETS_DIR}/tls/minerva-calendar-agent holds its server.crt and
# server.key (SAN minerva-calendar-agent, the name the API calls it by;
# CN the same, from Issuing CA 2, serverAuth), services-ca.crt
# and the three revocation lists.
TLS_CERT=/run/secrets/tls/server.crt
TLS_KEY=/run/secrets/tls/server.key
TLS_CA_SERVICES=/run/secrets/tls/services-ca.crt
TLS_CRL_SERVICES=/run/secrets/tls/service_issuing_ca_g1.crl,/run/secrets/tls/intermediate_ca_2.crl,/run/secrets/tls/root_ca_1.crl
AUTH_SERVICES_ISSUER=ncfritz.net Service Issuing CA 1 - G1
AUTH_SERVICE_CLIENTS=olympus-api
