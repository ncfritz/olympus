# Settings of this service on this host that are not secret and not wiring
# (hosts, ports and secret paths are in infra/docker/compose/olympus.yml).
# Minerva is behind the `minerva` profile until these are filled in.

LOKI_LEVEL=debug
CONSOLE_LOGGING_LEVEL=info

GOOGLE_OAUTH_CLIENT_ID=728437817202-o5loefc5st3n88e7lggjia4aekmei3hg.apps.googleusercontent.com
MICROSOFT_OAUTH_CLIENT_ID=74ee7649-b2c1-4089-bb0e-f9cbdfe9f6f3
MICROSOFT_OAUTH_TENANT_ID=common
# Who may sign in to the console. The providers themselves are a secret
# (${SECRETS_DIR}/minerva_oidc_providers): each carries a client secret.
AUTH_ALLOWED_EMAILS=ncfritz@ncfritz.net

POLL_INTERVAL_MS=45000
SYNC_WINDOW_PAST_DAYS=30
SYNC_WINDOW_FUTURE_DAYS=180
SYNC_HISTORY_RETENTION_DAYS=90
# Push notifications need a public HTTPS name at the border (auth phase 6);
# until then the agent polls.
WEBHOOK_BASE_URL=
# Publishing to Olympus over RabbitMQ (roadmap 8b).
OUTBOX_ENABLED=false
