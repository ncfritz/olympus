# Settings of this service on this host that are not secret and not wiring
# (hosts, ports and paths are in infra/docker/compose/olympus.yml).
# Minerva mail's classifier (ADR 0030, agents/minerva-mail-ml).

LOG_LEVEL=info

# The services listener, which only the mail agent calls, on the backend
# network (the Takeout runs too: in the agent's image, through stack.sh).
# The files are in ${SECRETS_DIR}/tls/minerva-mail-agent-ml: server.crt
# and server.key (CN and SAN minerva-mail-agent-ml, from the Service
# Issuing CA, for serverAuth), services-ca.crt and the three revocation
# lists. Its client certificate for the API is client.crt and client.key
# in the same directory (CN minerva-mail-agent-ml, clientAuth); the
# nightly retrain uses it too.
TLS_CERT=/run/secrets/tls/server.crt
TLS_KEY=/run/secrets/tls/server.key
TLS_CA_SERVICES=/run/secrets/tls/services-ca.crt
TLS_CRL_SERVICES=/run/secrets/tls/service_issuing_ca_g1.crl,/run/secrets/tls/intermediate_ca_2.crl,/run/secrets/tls/root_ca_1.crl
SERVICES_ISSUER=ncfritz.net Service Issuing CA 1 - G1
SERVICES_ALLOWED_CLIENTS=minerva-mail-agent

# Learning from approvals in the inbox, every this many seconds; 0: never.
LEARN_SECONDS=60

# Embeddings (phase 6): Ollama on the host, outside Docker, with the model
# pulled (`ollama pull nomic-embed-text`). Docker Desktop reaches the
# host's loopback at host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434
EMBED_MODEL=nomic-embed-text
