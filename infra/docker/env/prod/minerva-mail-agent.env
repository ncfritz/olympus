# Settings of this service on this host that are not secret and not wiring
# (hosts, ports and secret paths are in infra/docker/compose/olympus.yml).
# Minerva mail (ADR 0030, docs/plans/email-management).

LOKI_LEVEL=info
CONSOLE_LOGGING_LEVEL=info

# Mail's own Google OAuth client: a Web application client in the calendar
# agent's Google project, on its Internal consent screen, with
# https://olympus.ncfritz.net/api/v1/minerva/mail/accounts/callback
# registered. Its secret is the minerva_mail_google_oauth_client_secret
# secret.
MAIL_GOOGLE_OAUTH_CLIENT_ID=728437817202-5l0vdb4qtilolkotif8bcrs4vl9i26s8.apps.googleusercontent.com

# Seconds between history polls of each linked mailbox (0: no polling).
MAIL_GMAIL_POLL_SECONDS=60

# Approved label changes and filters written to Gmail (phases 4 and 7). On,
# linking asks for gmail.modify and gmail.settings.basic as well as
# gmail.readonly. The API has its own switch for writes,
# MINERVA_MAIL_WRITES_ENABLED.
MAIL_WRITES_ENABLED=true
MAIL_FILTERS_ENABLED=true

# The services listener, which only the API calls (to link a mailbox). The
# files are in ${SECRETS_DIR}/tls/minerva-mail-agent: server.crt and
# server.key (CN and SAN minerva-mail-agent, from Issuing CA 2, for
# serverAuth), services-ca.crt and the three revocation lists. Its
# client certificate for the API and the classifier is client.crt and
# client.key in the same directory (CN minerva-mail-agent, clientAuth).
TLS_CERT=/run/secrets/tls/server.crt
TLS_KEY=/run/secrets/tls/server.key
TLS_CA_SERVICES=/run/secrets/tls/services-ca.crt
TLS_CRL_SERVICES=/run/secrets/tls/service_issuing_ca_g1.crl,/run/secrets/tls/intermediate_ca_2.crl,/run/secrets/tls/root_ca_1.crl
AUTH_SERVICES_ISSUER=ncfritz.net Service Issuing CA 1 - G1
AUTH_SERVICE_CLIENTS=olympus-api
