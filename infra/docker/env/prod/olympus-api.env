>>>>>>> 70fcc246 (Updating allowed CIDRS to only include the Docker host)
WEATHER_STATION_ALLOWED_CIDRS=192.168.65.1/32
# Every archived push is published for the dev relay (ADR 0025). Prod only.
WEATHER_RELAY_PUBLISH=true
# Gaps in the samples are filled from ambientweather.net hourly (the keys
# are the ambient_* secrets). Prod only.
WEATHER_BACKFILL_ENABLED=true
