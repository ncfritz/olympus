# Settings of this service on this host that are not secret and not wiring
# (hosts, ports and secret paths are in infra/docker/compose/olympus.yml).

ENABLE_API_EXPLORER=true
LOKI_LEVEL=debug
CONSOLE_LOGGING_LEVEL=debug

# Authentication (ADR 0018): report until enforcement (auth phase 8).
AUTH_MODE_USERS=report
AUTH_MODE_SERVICES=report
# The mTLS listener, which starts because these are set. The files are in
# ${SECRETS_DIR}/tls/olympus-api (see docs/guides/certificates.md).
TLS_CERT=/run/secrets/tls/api.crt
TLS_KEY=/run/secrets/tls/api.key
TLS_CA_SERVICES=/run/secrets/tls/services-ca.crt
# One list per signing authority in the chain, as separate files: Node
# reads only the first list in a file and checks the whole chain, so a
# missing or expired one refuses every service (ADR 0023). Re-export all
# three before their nextUpdate, whether or not anything was revoked.
TLS_CRL_SERVICES=/run/secrets/tls/service_issuing_ca_g1.crl,/run/secrets/tls/intermediate_ca_2.crl,/run/secrets/tls/root_ca_1.crl
# The CA that must have signed a client certificate, whatever the chain
# built to. The issuing CAs are siblings, so the chain alone does not
# separate services from devices (ADR 0023). Unquoted: the value is the
# rest of the line, and quotes would become part of the name.
AUTH_SERVICES_ISSUER=ncfritz.net Service Issuing CA 1 - G1
# Only the NAS presents a certificate today; the four are listed because a
# service absent from here is reported as unknown rather than refused
# (AUTH_MODE_SERVICES=report), and this is what it will be when they do.
AUTH_SERVICE_ROLES=dionysus-asset-agent:agent,dionysus-metadata-agent:agent,dionysus-search-agent:agent,olympus-notification-agent:agent
