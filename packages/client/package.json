{
  "name": "@ncfritz/olympus-client",
  "description": "Wrappers over the Olympus SDK for services and the site: one client per API, identified callers and request metrics",
  "version": "0.0.0",
  "private": true,
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "default": "./dist/nest.js"
    },
    "./prometheus": {
      "types": "./dist/prometheus.d.ts",
      "default": "./dist/prometheus.js"
    },
    "./tls": {
      "types": "./dist/tls.d.ts",
      "default": "./dist/tls.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint src test",
    "lintfix": "eslint src test --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ncfritz/olympus-metrics": "workspace:*",
    "@ncfritz/olympus-sdk": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "catalog:",
    "prom-client": "catalog:"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "prom-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ncfritz/olympus-config": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/testing": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axios": "^1.13.2",
    "esbuild": "^0.28.2",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "prom-client": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
