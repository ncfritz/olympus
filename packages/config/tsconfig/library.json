{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Olympus library package",
  "extends": "./base.json",
  "compilerOptions": {
    "outDir": "${configDir}/dist",
    "rootDir": "${configDir}/src"
  },
  "include": ["${configDir}/src/**/*.ts"],
  "exclude": ["${configDir}/**/*.spec.ts", "${configDir}/**/*.test.ts"]
}
