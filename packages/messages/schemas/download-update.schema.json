        "destDirectory": {
          "type": [
            "string",
            "null"
          ]
        },
        "nzbDirectory": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "nzbId": {
          "type": [
            "string",
            "null"
          ]
        },
        "scriptStatus": {
          "type": [
            "string",
            "null"
          ]
        },
        "parStatus": {
          "type": [
            "string",
            "null"
          ]
        },
        "unpackStatus": {
          "type": [
            "string",
            "null"
          ]
        }
