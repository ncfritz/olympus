      "required": [
        "category",
        "destDirectory",
        "nzbDirectory",
        "nzbFilename",
        "nzbId",
        "nzbName",
        "parStatus",
        "scriptStatus",
        "status",
        "ts",
        "type",
        "unpackStatus"
      ],
      "additionalProperties": false,
      "description": "Post-processing finished (post-process script)."
    }
  }
}
