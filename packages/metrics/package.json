{
  "name": "@ncfritz/olympus-metrics",
  "description": "The Olympus request metrics convention: metric and label names, the client header, operation lookup from OpenAPI documents, and a Prometheus recorder",
  "version": "0.0.0",
  "private": true,
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prometheus": {
      "types": "./dist/prometheus.d.ts",
      "default": "./dist/prometheus.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint src test",
    "lintfix": "eslint src test --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "prom-client": "catalog:"
  },
  "peerDependenciesMeta": {
    "prom-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ncfritz/olympus-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "prom-client": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
