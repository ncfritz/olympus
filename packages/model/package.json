{
  "name": "@ncfritz/olympus-model",
  "description": "Contains the model and request/response types for Olympus",
  "version": "1.9.0",
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ncfritz/olympus-model.git"
  },
  "readmeFilename": "README.md",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "prepare": "is-ci || husky install",
    "clean": "rimraf dist && rimraf tsconfig.tsbuildinfo",
    "prebuild": "rimraf dist",
    "build": "tsc --incremental false",
    "lint": "eslint ./src",
    "lintfix": "eslint ./src --fix"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.7",
    "@nestjs/core": "^11.0.7",
    "@nestjs/swagger": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "moment": "^2.30.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^6.4.17",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "commitizen": "^4.3.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "semantic-release": "^24.2.1",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1"
  },
  "peerDependencies": {
    "nodemailer": "^7.0.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
