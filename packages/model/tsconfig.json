{
  "extends": "@ncfritz/olympus-config/tsconfig/nest.json",
  "compilerOptions": {
    // The model is consumed as a library, so it emits CommonJS with
    // declarations (the Nest preset turns declarations off for apps).
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "declarationMap": true,
    // As before the import: every @ApiProperty names its type explicitly,
    // so design-time type metadata is not needed (and would require
    // type-only imports for Moment).
    "emitDecoratorMetadata": false
  }
}
