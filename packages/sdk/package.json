{
  "name": "@ncfritz/olympus-sdk",
  "description": "Typescript client for the Olympus set of APIs.",
  "version": "1.0.0",
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ncfritz/olympus-sdk.git"
  },
  "readmeFilename": "README.md",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./dionysus": {
      "types": "./dist/dionysus/index.d.ts",
      "default": "./dist/dionysus/index.js"
    },
    "./minerva": {
      "types": "./dist/minerva/index.d.ts",
      "default": "./dist/minerva/index.js"
    },
    "./olympus": {
      "types": "./dist/olympus/index.d.ts",
      "default": "./dist/olympus/index.js"
    }
  },
  "scripts": {
    "prepare": "is-ci || husky install",
    "clean": "rimraf dist && rimraf src && rimraf tsconfig.tsbuildinfo",
    "gen-olympus": "openapi-ts -f config/olympus.ts",
    "gen-dionysus": "openapi-ts -f config/dionysus.ts",
    "gen-minerva": "openapi-ts -f config/minerva.ts",
    "prebuild": "npm run clean && npm run gen-olympus && npm run gen-dionysus && npm run gen-minerva",
    "build": "tsc",
    "lint": "eslint ./src",
    "lintfix": "eslint ./src --fix"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "debug": "^4.4.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@hey-api/openapi-ts": "^0.80.1",
    "@ncfritz/olympus-api": "latest",
    "@semantic-release/git": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "commitizen": "^4.3.1",
    "conventional-changelog-conventionalcommits": "^9.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.2.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
