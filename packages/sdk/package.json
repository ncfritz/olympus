{
  "name": "@ncfritz/olympus-sdk",
  "description": "TypeScript client for the Olympus APIs, generated from the API's OpenAPI documents",
  "version": "0.0.0",
  "private": true,
  "author": "Neil Fritz (ncfritz@ncfritz.net)",
  "license": "Apache-2.0",
  "exports": {
    "./dionysus": {
      "types": "./dist/dionysus/index.d.ts",
      "default": "./dist/dionysus/index.js"
    },
    "./minerva": {
      "types": "./dist/minerva/index.d.ts",
      "default": "./dist/minerva/index.js"
    },
    "./olympus": {
      "types": "./dist/olympus/index.d.ts",
      "default": "./dist/olympus/index.js"
    }
  },
  "scripts": {
    "generate": "openapi-ts && node scripts/generate-operations.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint openapi-ts.config.ts scripts",
    "lintfix": "eslint openapi-ts.config.ts scripts --fix",
    "clean": "rm -rf dist src/generated"
  },
  "dependencies": {
    "axios": "^1.13.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@ncfritz/olympus-api": "workspace:*",
    "@ncfritz/olympus-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
