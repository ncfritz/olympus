{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // The clients are generated from the committed API documents
    // (scripts/documents.mjs; each package's `openapi` task) before they
    // are compiled or checked.
    "build": { "dependsOn": ["generate", "^build"] },
    "typecheck": { "dependsOn": ["generate"] }
  }
}
