{
  "expo": {
    "name": "Olympus auth tester",
    "slug": "olympus-auth-tester",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "olympus-auth-tester",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.ncfritz.olympus.authtester",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "net.ncfritz.olympus.authtester"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Unlocks the Olympus tokens this tester stores on the device."
        }
      ]
    ]
  }
}
