import {
  afterAll,
  beforeAll,
  beforeEach,
  describe,
{{#if hasId}}
  expect,
{{else if isPaginated}}
  expect,
{{/if}}
  it,
} from "vitest";
import { createTestApp, type TestApp } from "{{toTestSupport}}/testApp";

// See docs/guides/api-testing.md. Register a Hasura response per GraphQL
// operation with t.graphql.on("<OperationName>", ...); unregistered
// operations fail the request.
describe("{{nestMethodUpper}} /v1/{{domain}}{{route}} ({{operationId}})", () => {
  let t: TestApp;
  beforeAll(async () => {
    t = await createTestApp();
  });
  afterAll(async () => {
    await t.app.close();
  });
  beforeEach(() => t.reset());

  it.todo("responds with the {{#if isDelete}}deletion{{else}}{{#if isList}}converted {{words entityPlural}}{{else}}{{#if isCreate}}created {{words entity}}{{else}}{{#if isGet}}computed result{{else}}converted {{words entity}}{{/if}}{{/if}}{{/if}}{{/if}}");
{{#if isPaginated}}

  it("rejects an invalid sort field", async () => {
    await t.http().get("{{testUrl}}?sortBy=bad%20field").expect(400);
    expect(t.graphql.calls("{{operationId}}")).toHaveLength(0);
  });
{{/if}}
{{#if hasId}}

  it("responds 404 when the {{words entity}} does not exist", async () => {
    t.graphql.on("{{operationId}}", {
      {{#if isDescribe}}{{hasuraTable}}_by_pk{{/if}}{{#if isUpdate}}update_{{hasuraTable}}_by_pk{{/if}}{{#if isDelete}}delete_{{hasuraTable}}_by_pk{{/if}}: null,
    });

    await t
      .http()
      .{{httpMethod}}("{{testUrl}}")
{{#if hasBody}}
      .send({ {{entityCamel}}: {} })
{{/if}}
      .expect(404);
    // A 404 from an unregistered route would not reach Hasura.
    expect(t.graphql.calls("{{operationId}}")).toHaveLength(1);
  });
{{/if}}
});
