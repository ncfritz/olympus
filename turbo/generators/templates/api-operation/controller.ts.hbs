import {
{{#if hasBody}}
  {{requestClass}},
{{/if}}
{{#unless isDelete}}
  {{responseClass}},
{{/unless}}
{{#if isPaginated}}
  SortDirection,
{{/if}}
} from "@ncfritz/olympus-model";
import {
{{#if hasBody}}
  Body,
{{/if}}
  Controller,
  {{nestMethod}},
  HttpStatus,
{{#if hasId}}
  Param,
{{#if numericId}}
  ParseIntPipe,
{{/if}}
{{/if}}
{{#if isPaginated}}
  Query,
{{/if}}
  Res,
} from "@nestjs/common";
import {
{{#if hasBody}}
  ApiBody,
  ApiConsumes,
{{/if}}
{{#if isCreate}}
  ApiCreatedResponse,
{{/if}}
{{#if isDelete}}
  ApiNoContentResponse,
{{/if}}
{{#unless isCreate}}{{#unless isDelete}}
  ApiOkResponse,
{{/unless}}{{/unless}}
  ApiOperation,
{{#if hasId}}
  ApiParam,
{{/if}}
  ApiProduces,
} from "@nestjs/swagger";
import { type Response } from "express";
import {
{{#if isPaginated}}
  ApiFilterParams,
  ApiPaginationParams,
{{/if}}
  ApiStandardErrorResponses,
} from "{{toSrc}}/utils/controllerDecorators";
import { {{service}} } from "../services/{{service}}";

@Controller({ version: "1" })
export class {{operationId}}Controller {
  constructor(private readonly {{serviceProp}}: {{service}}) {}

  @{{nestMethod}}("{{route}}")
  @ApiOperation({
    summary: "TODO: {{words operationId}}",
    description: "TODO: describe what {{operationId}} does.",
    operationId: "{{operationId}}",
    tags: ["{{tag}}"],
  })
{{#if hasBody}}
  @ApiConsumes("application/json")
{{/if}}
  @ApiProduces("application/json")
{{#if hasId}}
  @ApiParam({
    name: "{{idParam}}",
    description: "The ID of the {{words entity}}",
    type: {{#if numericId}}Number{{else}}String{{/if}},
  })
{{/if}}
{{#if isPaginated}}
  @ApiPaginationParams()
  @ApiFilterParams()
{{/if}}
{{#if hasBody}}
  @ApiBody({
    type: {{requestClass}},
    required: true,
    description: "Input for the {{operationId}} operation",
  })
{{/if}}
{{#if isCreate}}
  @ApiCreatedResponse({
    description: "The {{words entity}} was created.",
    type: {{responseClass}},
  })
{{/if}}
{{#if isDelete}}
  @ApiNoContentResponse({
    description: "The {{words entity}} was deleted.",
  })
{{/if}}
{{#if isDescribe}}
  @ApiOkResponse({
    description: "The {{words entity}} was found.",
    type: {{responseClass}},
  })
{{/if}}
{{#if isList}}
  @ApiOkResponse({
    description: "The {{words entityPlural}} were fetched.",
    type: {{responseClass}},
  })
{{/if}}
{{#if isUpdate}}
  @ApiOkResponse({
    description: "The {{words entity}} was updated.",
    type: {{responseClass}},
  })
{{/if}}
{{#if isGet}}
  @ApiOkResponse({
    description: "The result was computed.",
    type: {{responseClass}},
  })
{{/if}}
  @ApiStandardErrorResponses()
  async handle(
{{#if hasId}}
    @Param("{{idParam}}"{{#if numericId}}, ParseIntPipe{{/if}}) {{idParam}}: {{idTsType}},
{{/if}}
{{#if isPaginated}}
    @Query("pageSize") pageSize = 25,
    @Query("startPage") startPage = 0,
    @Query("sort") sortDirection: SortDirection = SortDirection.DESC,
    @Query("sortBy") sortField = "createdTime",
    @Query("filters") filters: string | undefined,
{{/if}}
{{#if hasBody}}
    @Body() request: {{requestClass}},
{{/if}}
    @Res() response: Response,
  ): Promise<void> {
{{#if isDescribe}}
    const responseBody: {{responseClass}} = {
      {{entityCamel}}: await this.{{serviceProp}}.{{method}}({{idParam}}),
    };
    response.status(HttpStatus.OK).send(responseBody);
{{/if}}
{{#if isList}}
{{#if isPaginated}}
    const { {{entitiesCamel}}, count } = await this.{{serviceProp}}.{{method}}(
      { pageSize, startPage, sortField, sortDirection },
      filters,
    );
    const responseBody: {{responseClass}} = { {{entitiesCamel}}, count };
{{else}}
    const responseBody: {{responseClass}} = {
      {{entitiesCamel}}: await this.{{serviceProp}}.{{method}}(),
    };
{{/if}}
    response.status(HttpStatus.OK).send(responseBody);
{{/if}}
{{#if isCreate}}
    const responseBody: {{responseClass}} = {
      {{entityCamel}}: await this.{{serviceProp}}.{{method}}(request.{{entityCamel}}),
    };
    response.status(HttpStatus.CREATED).send(responseBody);
{{/if}}
{{#if isUpdate}}
    const responseBody: {{responseClass}} = {
      {{entityCamel}}: await this.{{serviceProp}}.{{method}}(
        {{idParam}},
        request.{{entityCamel}},
      ),
    };
    response.status(HttpStatus.OK).send(responseBody);
{{/if}}
{{#if isDelete}}
    await this.{{serviceProp}}.{{method}}({{idParam}});
    response.status(HttpStatus.NO_CONTENT).end();
{{/if}}
{{#if isGet}}
    const responseBody: {{responseClass}} = {
      count: await this.{{serviceProp}}.{{method}}(),
    };
    response.status(HttpStatus.OK).send(responseBody);
{{/if}}
  }
}
