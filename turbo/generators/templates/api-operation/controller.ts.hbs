type GraphQl{{operationId}}Response = {
{{#if isDescribe}}
  {{hasuraTable}}_by_pk: GraphQl{{entity}} | null;
{{/if}}
{{#if isList}}
  {{hasuraTable}}: GraphQl{{entity}}[];
{{#if isPaginated}}
  {{hasuraTable}}_aggregate: { aggregate: { count: number } };
{{/if}}
{{/if}}
{{#if isCreate}}
  insert_{{hasuraTable}}_one: GraphQl{{entity}};
{{/if}}
{{#if isUpdate}}
  update_{{hasuraTable}}_by_pk: GraphQl{{entity}} | null;
{{/if}}
{{#if isDelete}}
  delete_{{hasuraTable}}_by_pk: { id: {{idTsType}} } | null;
{{/if}}
{{#if isGet}}
  // TODO: the root field(s) this operation queries
  {{hasuraTable}}_aggregate: { aggregate: { count: number } };
{{/if}}
};

@Controller({ version: "1" })
export class {{operationId}}Controller {
  constructor(private readonly graphQLClient: GraphQLClient) {}

  @{{nestMethod}}("{{route}}")
  @ApiOperation({
    summary: "TODO: {{words operationId}}",
    description: "TODO: describe what {{operationId}} does.",
    operationId: "{{operationId}}",
    tags: ["{{tag}}"],
  })
{{#if hasBody}}
  @ApiConsumes("application/json")
{{/if}}
  @ApiProduces("application/json")
{{#if hasId}}
  @ApiParam({
    name: "{{idParam}}",
    description: "The ID of the {{words entity}}",
    type: {{#if numericId}}Number{{else}}String{{/if}},
  })
{{/if}}
{{#if isPaginated}}
  @ApiPaginationParams()
  @ApiFilterParams()
{{/if}}
{{#if hasBody}}
  @ApiBody({
    type: {{requestClass}},
    required: true,
    description: "Input for the {{operationId}} operation",
  })
{{/if}}
{{#if isCreate}}
  @ApiCreatedResponse({
    description: "The {{words entity}} was created.",
    type: {{responseClass}},
  })
{{/if}}
{{#if isDelete}}
  @ApiNoContentResponse({
    description: "The {{words entity}} was deleted.",
  })
{{/if}}
{{#if isDescribe}}
  @ApiOkResponse({
    description: "The {{words entity}} was found.",
    type: {{responseClass}},
  })
{{/if}}
{{#if isList}}
  @ApiOkResponse({
    description: "The {{words entityPlural}} were fetched.",
    type: {{responseClass}},
  })
{{/if}}
{{#if isUpdate}}
  @ApiOkResponse({
    description: "The {{words entity}} was updated.",
    type: {{responseClass}},
  })
{{/if}}
{{#if isGet}}
  @ApiOkResponse({
    description: "The result was computed.",
    type: {{responseClass}},
  })
{{/if}}
  @ApiStandardErrorResponses()
  async handle(
{{#if hasId}}
    @Param("{{idParam}}"{{#if numericId}}, ParseIntPipe{{/if}}) {{idParam}}: {{idTsType}},
{{/if}}
{{#if isPaginated}}
    @Query("pageSize") pageSize = 25,
    @Query("startPage") startPage = 0,
    @Query("sort") sortDirection: SortDirection = SortDirection.DESC,
    @Query("sortBy") sortField = "createdTime",
    @Query("filters") filters: string | undefined,
{{/if}}
{{#if hasBody}}
    @Body() request: {{requestClass}},
{{/if}}
    @Res() response: Response,
  ): Promise<void> {
{{#if isDescribe}}
    const query = gql`
      query {{operationId}}($id: {{idType}}!) {
        {{hasuraTable}}_by_pk(id: $id) {
          # TODO: select the fields toDomainObject reads
          id
        }
      }
    `;

    const result =
      await this.graphQLClient.request<GraphQl{{operationId}}Response>(query, {
        id: {{idParam}},
      });

    if (result.{{hasuraTable}}_by_pk === null) {
      throw new NotFoundException(`{{entity}} with id ${ {{~idParam~}} } not found`);
    }

    const responseBody: {{responseClass}} = {
      {{entityCamel}}: toDomainObject(result.{{hasuraTable}}_by_pk),
    };

    response.status(HttpStatus.OK).send(responseBody);
{{/if}}
{{#if isList}}
{{#if isPaginated}}
    const pagination = buildPaginationExpression({
      pageSize,
      startPage,
      sortField,
      sortDirection,
    });
    const where = buildFilterExpression(filters);

    const query = gql`
      query {{operationId}} {
        {{hasuraTable}}(${[pagination, where].filter(Boolean).join(", ")}) {
          # TODO: select the fields toDomainObject reads
          id
        }
        {{hasuraTable}}_aggregate${where ? `(${where})` : ""} {
          aggregate {
            count
          }
        }
      }
    `;
{{else}}
    const query = gql`
      query {{operationId}} {
        {{hasuraTable}} {
          # TODO: select the fields toDomainObject reads
          id
        }
      }
    `;
{{/if}}

    const result =
      await this.graphQLClient.request<GraphQl{{operationId}}Response>(query);

    const responseBody: {{responseClass}} = {
      {{entitiesCamel}}: result.{{hasuraTable}}.map((row) => toDomainObject(row)),
{{#if isPaginated}}
      count: result.{{hasuraTable}}_aggregate.aggregate.count,
{{/if}}
    };

    response.status(HttpStatus.OK).send(responseBody);
{{/if}}
{{#if isCreate}}
    const mutation = gql`
      mutation {{operationId}}($object: {{hasuraTable}}_insert_input!) {
        insert_{{hasuraTable}}_one(object: $object) {
          # TODO: select the fields toDomainObject reads
          id
        }
      }
    `;

    // TODO: map request.{{entityCamel}} (camelCase) to the table's columns
    const result =
      await this.graphQLClient.request<GraphQl{{operationId}}Response>(
        mutation,
        { object: request.{{entityCamel}} },
      );

    const responseBody: {{responseClass}} = {
      {{entityCamel}}: toDomainObject(result.insert_{{hasuraTable}}_one),
    };

    response.status(HttpStatus.CREATED).send(responseBody);
{{/if}}
{{#if isUpdate}}
    const mutation = gql`
      mutation {{operationId}}($id: {{idType}}!, $changes: {{hasuraTable}}_set_input!) {
        update_{{hasuraTable}}_by_pk(pk_columns: { id: $id }, _set: $changes) {
          # TODO: select the fields toDomainObject reads
          id
        }
      }
    `;

    // TODO: map request.{{entityCamel}} (camelCase) to the table's columns
    const result =
      await this.graphQLClient.request<GraphQl{{operationId}}Response>(
        mutation,
        { id: {{idParam}}, changes: request.{{entityCamel}} },
      );

    if (result.update_{{hasuraTable}}_by_pk === null) {
      throw new NotFoundException(`{{entity}} with id ${ {{~idParam~}} } not found`);
    }

    const responseBody: {{responseClass}} = {
      {{entityCamel}}: toDomainObject(result.update_{{hasuraTable}}_by_pk),
    };

    response.status(HttpStatus.OK).send(responseBody);
{{/if}}
{{#if isDelete}}
    const mutation = gql`
      mutation {{operationId}}($id: {{idType}}!) {
        delete_{{hasuraTable}}_by_pk(id: $id) {
          id
        }
      }
    `;

    const result =
      await this.graphQLClient.request<GraphQl{{operationId}}Response>(
        mutation,
        { id: {{idParam}} },
      );

    if (result.delete_{{hasuraTable}}_by_pk === null) {
      throw new NotFoundException(`{{entity}} with id ${ {{~idParam~}} } not found`);
    }

    response.status(HttpStatus.NO_CONTENT).end();
{{/if}}
{{#if isGet}}
    // TODO: query and compute the result
    const query = gql`
      query {{operationId}} {
        {{hasuraTable}}_aggregate {
          aggregate {
            count
          }
        }
      }
    `;

    const result =
      await this.graphQLClient.request<GraphQl{{operationId}}Response>(query);

    const responseBody: {{responseClass}} = {
      count: result.{{hasuraTable}}_aggregate.aggregate.count,
    };

    response.status(HttpStatus.OK).send(responseBody);
{{/if}}
  }
}
