{{#if isList}}
{{#if isPaginated}}
  /** {{operationId}}: one page of {{words entityPlural}} and the total count. */
  async {{method}}(
    pagination: PaginationParams,
    filters: string | undefined,
  ): Promise<{ {{entitiesCamel}}: {{entity}}[]; count: number }> {
    type Result = {
      {{hasuraTable}}: GraphQl{{entity}}[];
      {{hasuraTable}}_aggregate: { aggregate: { count: number } };
    };
    const page = buildPaginationExpression(pagination);
    const where = buildFilterExpression(filters);

    const query = gql`
      query {{operationId}} {
        {{hasuraTable}}(${[page, where].filter(Boolean).join(", ")}) {
          # TODO: select the fields toDomainObject reads
          id
        }
        {{hasuraTable}}_aggregate${where ? `(${where})` : ""} {
          aggregate {
            count
          }
        }
      }
    `;

    const result = await this.graphQLClient.request<Result>(query);
    return {
      {{entitiesCamel}}: result.{{hasuraTable}}.map(toDomainObject),
      count: result.{{hasuraTable}}_aggregate.aggregate.count,
    };
  }
